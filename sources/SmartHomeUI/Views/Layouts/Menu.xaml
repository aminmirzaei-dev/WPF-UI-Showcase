<UserControl x:Class="SmartHomeUI.Views.Layouts.Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartHomeUI.Views.Layouts"
             xmlns:controls="clr-namespace:SmartHomeUI.Controls"
             mc:Ignorable="d">
    <Border CornerRadius="10"
            Background="#3253F1">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="1"
                              BlurRadius="20"
                              Opacity="0.4" />
        </Border.Effect>

        <Grid>
            <StackPanel>

                <!-- Home -->
                <controls:SHMenuItem Margin="15,40,15,20"
                                     Icon="Home"
                                     IsChecked="True"
                                     Checked="HomeItem_Checked"
                                     GroupName="MainMenu">

                </controls:SHMenuItem>

                <!-- Bedroom -->
                <controls:SHMenuItem Icon="Bed"
                                     Checked="RoomItem_Checked"
                                     GroupName="MainMenu">

                </controls:SHMenuItem>

                <!-- Users -->
                <controls:SHMenuItem Icon="AccountGroup"
                                     GroupName="MainMenu" />

                <!-- Security -->
                <controls:SHMenuItem Icon="Shield"
                                     GroupName="MainMenu" />

                <!-- Location -->
                <controls:SHMenuItem Icon="MapMarker"
                                     GroupName="MainMenu" />

                <!-- Reports -->
                <controls:SHMenuItem Icon="ChartBar"
                                     GroupName="MainMenu" />

                <!-- Settings -->
                <controls:SHMenuItem Icon="Cog"
                                     GroupName="MainMenu" />

            </StackPanel>

            <Ellipse x:Name="btnProfile"
                     Margin="15,505,20,0"
                     ToolTip="Made and designed by Amin Mirzaei (Github : aminmirzaei-dev)"
                     VerticalAlignment="Top"
                     Height="55"
                     Width="55"
                     Stretch="UniformToFill">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="/Resources/Images/Developer/AminMirzaei.png" />
                </Ellipse.Fill>
            </Ellipse>

            <!-- Exit -->
            <controls:SHMenuItem x:Name="btnExit"
                                 Icon="Logout"
                                 Margin="15,0,15,25"
                                 VerticalAlignment="Bottom"
                                 GroupName="MainMenu"
                                 Click="btnExit_Click" />

        </Grid>
    </Border>
    
</UserControl>
