<UserControl x:Class="SmartHomeUI.Views.Pages.Room"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartHomeUI.Views.Pages"
             xmlns:controls="clr-namespace:SmartHomeUI.Controls">
    <Border x:Name="roomPage"
            Style="{StaticResource borderPage}" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PageTransform"
                                Y="45" />
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>

                        <!-- Fade In -->
                        <DoubleAnimation Storyboard.TargetName="roomPage"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.65">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <!-- Slide Up -->
                        <DoubleAnimation Storyboard.TargetName="PageTransform"
                                         Storyboard.TargetProperty="Y"
                                         From="45"
                                         To="0"
                                         Duration="0:0:0.75">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Border CornerRadius="25">
            <Border.Background>
                <ImageBrush ImageSource="/Resources/Images/Home/Decoration2.jpg"
                            Stretch="Fill"
                            Opacity="0.6" />
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <!--Add Button-->
                <controls:AddButton Caption="Add New Device"
                                    Margin="0 40 40 0" />

                <!--Titles-->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0 40 0 0">
                    <TextBlock Foreground="#ffffff"
                               FontSize="32"
                               TextAlignment="Center">
                    <Run>32</Run><Run FontWeight="Thin"
                                      FontSize="26">°c</Run>
                    </TextBlock>
                    <TextBlock Text="Celcious"
                               Foreground="#ffffff"
                               FontSize="12"
                               TextAlignment="Center" />
                    <TextBlock Text="You Are Controlling"
                               Foreground="#ffffff"
                               FontSize="22"
                               TextAlignment="Center"
                               Margin="0 15 0 10" />
                    <TextBlock Text="Main Lounge and Living Room"
                               Foreground="#ffffff"
                               FontSize="36"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                </StackPanel>

                <!--Panels-->
                <Grid Grid.Row="1"
                      Margin="0 0 0 30"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--Cards-->
                    <controls:ToggleCard Grid.Column="0"
                                         IsHorizontal="True"
                                         Margin="12 0 12 0"
                                         Title="Refridgerator"
                                        Icon="Microphone" />
                    <controls:ToggleCard Grid.Column="1"
                                         IsHorizontal="True"
                                         Margin="12 0 12 0"
                                         Title="Temprature"
                                        Icon="Microphone"
                                         IsChecked="True" />
                    <controls:ToggleCard Grid.Column="2"
                                         IsHorizontal="True"
                                         Margin="12 0 12 0"
                                         Title="Air Conditioner"
                                       Icon="Microphone" />
                    <controls:ToggleCard Grid.Column="3"
                                         IsHorizontal="True"
                             Margin="12 0 12 0"
                             Title="Lights"
                             Icon="Microphone" />

                </Grid>
            </Grid>

        </Border>
    </Border>
</UserControl>
