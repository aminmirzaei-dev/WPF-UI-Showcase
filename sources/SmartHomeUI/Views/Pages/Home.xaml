<UserControl x:Class="SmartHomeUI.Views.Pages.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartHomeUI.Views.Pages"
             xmlns:controls="clr-namespace:SmartHomeUI.Controls">
    
    <Border x:Name="homePage"
            Style="{StaticResource borderPage}">
        <Border.RenderTransform>
            <TranslateTransform Y="0" />
        </Border.RenderTransform>

        <Border CornerRadius="25">
            <Border.Background>
                <ImageBrush ImageSource="/Resources/Images/Home/Decoration1.jpg"
                            Stretch="Fill"
                            Opacity="0.6" />
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <!--Titles-->
                <StackPanel VerticalAlignment="Center"
                            Margin="60 0 0 0">
                    <TextBlock Text="Controlling"
                               Foreground="#ffffff"
                               FontSize="22" />
                    <TextBlock Text="Lounge and Kitchen"
                               Foreground="#ffffff"
                               Margin="0 10 0 10"
                               FontSize="36"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Foreground="#ffffff"
                               FontSize="32">
                    <Run>32</Run><Run FontWeight="Thin"
                                      FontSize="26">°c</Run>
                    </TextBlock>
                    <TextBlock Text="Celcious"
                               Foreground="#ffffff"
                               FontSize="12"
                               Margin="15 0 0 0" />
                </StackPanel>

                <!--Panels-->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0 0 50 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--Cards-->
                        <controls:ToggleCard Grid.Row="0"
                                 Grid.Column="0"
                                 Margin="0 0 8 8"
                                 Title="Refridgerator"
                                 Icon="Microphone"/>
                        <controls:ToggleCard Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="8 0 0 8"
                                 Title="Temprature"
                                 Icon="Microphone"
                                 IsChecked="True" />
                        <controls:ToggleCard Grid.Row="1"
                                 Grid.Column="0"
                                 Margin="0 8 8 0"
                                 Title="Air Conditioner"
                                 Icon="Microphone" />
                        <controls:ToggleCard Grid.Row="1"
                                             Grid.Column="1"
                                             Margin="8 8 0 0"
                                             Title="Lights"
                                             Icon="Microphone" />
                    </Grid>

                    <!--Add Button-->
                    <controls:AddButton Caption="Add New Room"
                                  Grid.Column="1"
                                  Margin="0 50 0 0"
                                  HorizontalAlignment="Center" />

                </StackPanel>
            </Grid>

        </Border>
    </Border>
</UserControl>
