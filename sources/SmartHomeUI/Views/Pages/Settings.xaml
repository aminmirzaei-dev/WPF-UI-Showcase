<UserControl x:Class="SmartHomeUI.Views.Pages.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartHomeUI.Views.Pages"
             xmlns:controls="clr-namespace:SmartHomeUI.Controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SettingsText"
                         Color="#172B52" />
        <SolidColorBrush x:Key="SettingsSubText"
                         Color="#65779A" />
        <SolidColorBrush x:Key="SettingsBorder"
                         Color="#E8EEF7" />

        <Style x:Key="SectionCard"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#FFFFFF" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource SettingsBorder}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="17" />
            <Setter Property="Padding"
                    Value="16" />
            <Setter Property="Margin"
                    Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource SettingsText}" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <Style x:Key="SectionDescription"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource SettingsSubText}" />
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Margin"
                    Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource borderPage}"
            Background="#F8FAFE"
            x:Name="settingsPage"
            Padding="24"
            Opacity="0">

        <Border.RenderTransform>
            <TranslateTransform x:Name="PageTransform"
                                Y="45" />
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>

                        <!-- Fade In -->
                        <DoubleAnimation Storyboard.TargetName="settingsPage"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.65">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <!-- Slide Up -->
                        <DoubleAnimation Storyboard.TargetName="PageTransform"
                                         Storyboard.TargetProperty="Y"
                                         From="45"
                                         To="0"
                                         Duration="0:0:0.75">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- Page title -->
                <TextBlock Text="Settings"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#172B52"
                           Margin="4,0,0,20" />

                <!-- THEME -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,15">
                            <icons:PackIconMaterial Kind="ThemeLightDark"
                                                        Width="23"
                                                        Height="23"
                                                        Foreground="#24365B"
                                                        Margin="0,0,13,0"
                                                        VerticalAlignment="Center" />

                            <StackPanel>
                                <TextBlock Text="Theme"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Choose your preferred appearance"
                                           Style="{StaticResource SectionDescription}" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="2">
                            <controls:SettingsOptions x:Name="LightOption"
                                                     Title="Light"
                                                     Margin="0,0,8,0"
                                                     IsSelected="True">

                                <controls:SettingsOptions.IconContent>
                                    <icons:PackIconMaterial Kind="WhiteBalanceSunny"
                                                                Width="25"
                                                                Height="25"
                                                                Foreground="#2864FF" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                            <controls:SettingsOptions x:Name="DarkOption"
                                                     Title="Dark"
                                                     Margin="8,0,0,0">

                                <controls:SettingsOptions.IconContent>
                                    <icons:PackIconMaterial Kind="MoonWaningCrescent"
                                                                Width="25"
                                                                Height="25"
                                                                Foreground="#24365B" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- COLOR PALETTE -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,15">
                            <icons:PackIconMaterial Kind="Palette"
                                                        Width="23"
                                                        Height="23"
                                                        Foreground="#24365B"
                                                        Margin="0,0,13,0"
                                                        VerticalAlignment="Center" />

                            <StackPanel>
                                <TextBlock Text="Color Palette"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Select the main color for the application"
                                           Style="{StaticResource SectionDescription}" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="4">
                            <controls:SettingsOptions x:Name="BlueOption"
                                                     Title="Blue"
                                                     Margin="0,0,6,0"
                                                     IsSelected="True">
                                <controls:SettingsOptions.IconContent>
                                    <Ellipse Width="34"
                                             Height="34"
                                             Fill="#2864FF" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                            <controls:SettingsOptions x:Name="RedOption"
                                                     Title="Red"
                                                     Margin="4,0,4,0">
                                <controls:SettingsOptions.IconContent>
                                    <Ellipse Width="34"
                                             Height="34"
                                             Fill="#FF4658" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                            <controls:SettingsOptions x:Name="GreenOption"
                                                     Title="Green"
                                                     Margin="4,0,4,0">
                                <controls:SettingsOptions.IconContent>
                                    <Ellipse Width="34"
                                             Height="34"
                                             Fill="#20B978" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                            <controls:SettingsOptions x:Name="PurpleOption"
                                                     Title="Purple"
                                                     Margin="6,0,0,0">
                                <controls:SettingsOptions.IconContent>
                                    <Ellipse Width="34"
                                             Height="34"
                                             Fill="#9238F5" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- LANGUAGE -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,15">
                            <icons:PackIconMaterial Kind="Web"
                                                        Width="23"
                                                        Height="23"
                                                        Foreground="#24365B"
                                                        Margin="0,0,13,0"
                                                        VerticalAlignment="Center" />

                            <StackPanel>
                                <TextBlock Text="Language"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Choose your language"
                                           Style="{StaticResource SectionDescription}" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="5">

                            <!-- Flag placeholders: add your own images here -->

                            <controls:SettingsOptions x:Name="EnglishOption"
                                                     Title="English"
                                                     Margin="0,0,5,0"
                                                     IsSelected="True">
                                <controls:SettingsOptions.IconContent>
                                    <Border Width="34"
                                            Height="34"
                                            Background="Transparent" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                            <controls:SettingsOptions x:Name="PersianOption"
                                                     Title="فارسی"
                                                     Margin="3,0">
                                <controls:SettingsOptions.IconContent>
                                    <Border Width="34"
                                            Height="34"
                                            Background="Transparent" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                            <controls:SettingsOptions x:Name="GermanOption"
                                                     Title="Deutsch"
                                                     Margin="3,0">
                                <controls:SettingsOptions.IconContent>
                                    <Border Width="34"
                                            Height="34"
                                            Background="Transparent" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                            <controls:SettingsOptions x:Name="ChineseOption"
                                                     Title="中文"
                                                     Margin="3,0">
                                <controls:SettingsOptions.IconContent>
                                    <Border Width="34"
                                            Height="34"
                                            Background="Transparent" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                            <controls:SettingsOptions x:Name="SpanishOption"
                                                     Title="Español"
                                                     Margin="5,0,0,0">
                                <controls:SettingsOptions.IconContent>
                                    <Border Width="34"
                                            Height="34"
                                            Background="Transparent" />
                                </controls:SettingsOptions.IconContent>
                            </controls:SettingsOptions>

                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
