<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SmartHomeUI.Controls"
                    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Style TargetType="{x:Type controls:SHMenuItem}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Margin"
                Value="15,0,15,12" />
        <Setter Property="Height"
                Value="50" />
        <Setter Property="Width"
                Value="50" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SHMenuItem}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">

                        <Border.RenderTransform>
                            <ScaleTransform x:Name="RootScale"
                                            ScaleX="1"
                                            ScaleY="1" />
                        </Border.RenderTransform>

                        <Grid>
                            <icons:PackIconMaterial x:Name="MenuIcon"
                                                    Kind="{Binding Icon,
                             RelativeSource={RelativeSource TemplatedParent}}"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">

                                <icons:PackIconMaterial.RenderTransform>
                                    <ScaleTransform x:Name="IconScale"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                </icons:PackIconMaterial.RenderTransform>
                            </icons:PackIconMaterial>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="#183769" />
                            <Setter TargetName="MenuIcon"
                                    Property="Foreground"
                                    Value="White" />

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.14"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut"
                                                          Amplitude="0.25" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.14"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut"
                                                          Amplitude="0.25" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.04"
                                                         Duration="0:0:0.16" />

                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.04"
                                                         Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.16" />

                                        <DoubleAnimation Storyboard.TargetName="RootScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="White" />
                            <Setter TargetName="MenuIcon"
                                    Property="Foreground"
                                    Value="DodgerBlue" />
                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="MenuIcon"
                                    Property="Opacity"
                                    Value="0.35" />
                            <Setter TargetName="Root"
                                    Property="Opacity"
                                    Value="0.55" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="borderPage"
           TargetType="Border">
        <Setter Property="Background"
                Value="#000000" />
        <Setter Property="CornerRadius"
                Value="25" />
        <Setter Property="Grid.Column"
                Value="1" />
        <Setter Property="Margin"
                Value="30 0 0 0" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="1"
                                  BlurRadius="20"
                                  Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    
    <Style x:Key="addButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="#ffffff" />
        <Setter Property="Foreground"
                Value="#00192E" />
        <Setter Property="Padding"
                Value="0 3" />
        <Setter Property="Margin"
                Value="0 0 0 5" />
        <Setter Property="Height"
                Value="90" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="45">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#e0e0e0" />
            </Trigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>