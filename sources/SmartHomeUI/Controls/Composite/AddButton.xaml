<UserControl x:Class="SmartHomeUI.Controls.AddButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartHomeUI.Controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Name="addButton" Cursor="Hand">
    
    <Button Style="{StaticResource addButton}"
            Width="300"
            VerticalAlignment="Top"
            HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding ElementName=addButton,Path=Caption}"
                       VerticalAlignment="Center" />
            <Border Margin="20 0 0 0"
                    Width="40"
                    Padding="10"
                    Background="#3253F1"
                    CornerRadius="50">

                <icons:PackIconMaterial Kind="Plus"
                                        Foreground="White"
                                        Width="20"
                                        Height="20" />
            </Border>
        </StackPanel>
    </Button>
</UserControl>
