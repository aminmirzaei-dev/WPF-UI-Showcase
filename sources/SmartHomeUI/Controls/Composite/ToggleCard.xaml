<ToggleButton x:Class="SmartHomeUI.Controls.ToggleCard"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
              x:Name="toggleCard"
              Width="150"
              Height="150"
              Padding="0"
              BorderThickness="0"
              Background="Transparent"
              Focusable="True"
              Cursor="Hand">

    <ToggleButton.Template>
        <ControlTemplate TargetType="{x:Type ToggleButton}">

            <Grid ClipToBounds="False">

                <!-- Animated shadow layer -->
                <Border x:Name="ShadowLayer"
                        Margin="2,4,2,1"
                        CornerRadius="25"
                        Background="#3256F1"
                        Opacity="0.18">
                    <Border.Effect>
                        <BlurEffect Radius="15" />
                    </Border.Effect>
                </Border>

                <!-- Main card -->
                <Border x:Name="CardBackground"
                        Background="#EFEFEE"
                        CornerRadius="25"
                        Padding="20"
                        RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <TranslateTransform x:Name="CardTranslate"
                                            Y="0" />
                    </Border.RenderTransform>

                    <Grid>
                        <!-- Status -->
                        <TextBlock x:Name="StatusText"
                                   Text="Off"
                                   FontWeight="SemiBold"
                                   Foreground="#3256F1"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />

                        <!-- Icon -->
                        <icons:PackIconMaterial x:Name="CardIcon"
                                                Kind="{Binding Icon,
                                RelativeSource={RelativeSource TemplatedParent}}"
                                                Width="40"
                                                Height="40"
                                                Foreground="#3256F1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">

                            <icons:PackIconMaterial.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="IconScale"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                    <RotateTransform x:Name="IconRotate"
                                                     Angle="0" />
                                </TransformGroup>
                            </icons:PackIconMaterial.RenderTransform>
                        </icons:PackIconMaterial>

                        <!-- Title -->
                        <TextBlock x:Name="TitleText"
                                   Text="{Binding Title,
                                       RelativeSource={RelativeSource TemplatedParent}}"
                                   VerticalAlignment="Bottom"
                                   FontWeight="SemiBold"
                                   Foreground="#2F2C37"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- Visual states -->
                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroup x:Name="CheckStates">

                        <!-- OFF -->
                        <VisualState x:Name="Unchecked">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="CardBackground"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#EFEFEE"
                                                Duration="0:0:0.3" />

                                <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.18"
                                                 Duration="0:0:0.3" />

                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1"
                                                 Duration="0:0:0.2" />

                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1"
                                                 Duration="0:0:0.2" />

                                <DoubleAnimation Storyboard.TargetName="IconRotate"
                                                 Storyboard.TargetProperty="Angle"
                                                 To="0"
                                                 Duration="0:0:0.2" />

                                <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                 Storyboard.TargetProperty="Y"
                                                 To="0"
                                                 Duration="0:0:0.2" />
                            </Storyboard>
                        </VisualState>

                        <!-- ON -->
                        <VisualState x:Name="Checked">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="CardBackground"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#3256F1"
                                                Duration="0:0:0.3" />

                                <DoubleAnimation Storyboard.TargetName="ShadowLayer"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.55"
                                                 Duration="0:0:0.3" />

                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.15"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True" />

                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.15"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True" />

                                <DoubleAnimation Storyboard.TargetName="IconRotate"
                                                 Storyboard.TargetProperty="Angle"
                                                 To="12"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True" />

                                <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                 Storyboard.TargetProperty="Y"
                                                 To="-3"
                                                 Duration="0:0:0.15"
                                                 AutoReverse="True" />
                            </Storyboard>
                        </VisualState>

                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>

            <!-- Text and icon colors -->
            <ControlTemplate.Triggers>

                <Trigger Property="IsChecked"
                         Value="True">
                    <Setter TargetName="StatusText"
                            Property="Text"
                            Value="On" />
                    <Setter TargetName="StatusText"
                            Property="Foreground"
                            Value="White" />
                    <Setter TargetName="CardIcon"
                            Property="Foreground"
                            Value="White" />
                    <Setter TargetName="TitleText"
                            Property="Foreground"
                            Value="White" />
                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter TargetName="ShadowLayer"
                            Property="Opacity"
                            Value="0.35" />
                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.5" />
                </Trigger>



            </ControlTemplate.Triggers>
        </ControlTemplate>
    </ToggleButton.Template>
</ToggleButton>
