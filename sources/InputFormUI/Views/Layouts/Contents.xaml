<UserControl x:Class="InputFormUI.Views.Layouts.Contents"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InputFormUI.Views.Layouts"
             xmlns:controls="clr-namespace:InputFormUI.Controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <!--Left Section-->
    <Border
            Background="#F2F5F8"
            CornerRadius="0 0 0 5">
        <Grid VerticalAlignment="Center"
              Margin="70 0 -60 0">
            <!--Background Layers-->
            <Border CornerRadius="7 0 0 0"
                    Background="#F7F8FB"
                    Height="50"
                    Margin="40 -30 60 0"
                    VerticalAlignment="Top" />
            <Border CornerRadius="7 0 0 0"
                    Background="#FDFDFD"
                    Height="50"
                    Margin="20 -15 60 0"
                    VerticalAlignment="Top" />

            <!--Main Layer-->
            <Border CornerRadius="7"
                    Background="#ffffff">
                <Border.Effect>
                    <DropShadowEffect Direction="-130"
                                      BlurRadius="30"
                                      ShadowDepth="5"
                                      Opacity="0.1" />
                </Border.Effect>

                <Grid Margin="20 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--Form Title-->
                    <StackPanel Orientation="Horizontal"
                                Margin="20 20 0 0">
                        <Border CornerRadius="50"
                                BorderThickness="1.5"
                                BorderBrush="#EFEFEF">
                            <Ellipse Width="40"
                                     Height="40">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/Resources/Icons/Vector1.png" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>

                        <TextBlock Text="Business Details"
                                   Foreground="#374655"
                                   FontSize="18"
                                   Margin="15 0 0 0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!--Form Percentage-->
                    <StackPanel Orientation="Horizontal"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Margin="0 20 20 0">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="50"
                                BorderThickness="3"
                                ClipToBounds="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush>
                                    <GradientStop Color="Tomato"
                                                  Offset="0" />
                                    <GradientStop Color="#EFEFEF"
                                                  Offset="0.4" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>

                        <StackPanel Margin="10 0 0 0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="10%"
                                       Foreground="Tomato"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Profile Completion"
                                       Foreground="#97A5B4"
                                       Margin="0 2 0 0" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Height="0.7"
                               Margin="-20 20 -20 20"
                               Background="#E1E6EB" />

                    
                    <!-- Inputs -->

                    <!-- Left Column -->
                    <controls:IFTextBox Grid.Column="0"
                                        Grid.Row="2"
                                        Margin="0 10 10 10"
                                        Icon="Account"
                                        Placeholder="Enter your legal name" />

                    <controls:IFTextBox Grid.Column="0"
                                        Grid.Row="3"
                                        Margin="0 10 10 10"
                                        Icon="Email"
                                        Placeholder="Enter your email" />

                    <controls:IFTextBox Grid.Column="0"
                                        Grid.Row="4"
                                        Margin="0 10 10 10"
                                        Icon="Phone"
                                        Placeholder="Enter your phone" />

                    <controls:IFTextBox Grid.Column="0"
                                        Grid.Row="5"
                                        Margin="0 10 10 10"
                                        Icon="MapMarker"
                                        Placeholder="Enter your address" />

                    <!-- Right Column -->
                    <controls:IFTextBox Grid.Column="1"
                                        Grid.Row="2"
                                        Margin="10 10 0 10"
                                        Icon="Domain"
                                        Placeholder="Enter your business name" />

                    <controls:IFTextBox Grid.Column="1"
                                        Grid.Row="3"
                                        Margin="10 10 0 10"
                                        Icon="Web"
                                        Placeholder="Enter your website" />

                    <controls:IFTextBox Grid.Column="1"
                                        Grid.Row="4"
                                        Margin="10 10 0 10"
                                        Icon="CurrencyUsd"
                                        Placeholder="Enter your currency" />

                    <controls:IFTextBox Grid.Column="1"
                                        Grid.Row="5"
                                        Margin="10 10 0 10"
                                        Icon="MapMarker"
                                        Placeholder="Enter your address" />
                    


                    <!--Form Bottom Background-->
                    <Border Grid.Row="6"
                            Grid.ColumnSpan="2"
                            Height="80"
                            Background="#f6f6f6"
                            CornerRadius="0 0 10 10"
                            Margin="-20 40 -20 0" />

                    <!--Main Button-->
                    <Button Grid.Column="1"
                            Grid.Row="6"
                            Content="Save Next"
                            HorizontalAlignment="Right"
                            Margin="0 40 20 0"
                            Style="{StaticResource mainButton}">
                        <Button.Effect>
                            <DropShadowEffect Direction="-120"
                                              BlurRadius="10"
                                              Opacity="0.3"
                                              ShadowDepth="5"
                                              Color="Tomato" />
                        </Button.Effect>
                    </Button>

                    <!--Secondary Button-->
                    <Button Grid.Row="6"
                            Content="Back"
                            HorizontalAlignment="Left"
                            Margin="20 40 0 0"
                            Style="{StaticResource secondaryButton}"
                            Width="150" />

                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
