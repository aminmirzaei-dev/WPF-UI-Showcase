<UserControl x:Class="InputFormUI.Views.Layouts.Title"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InputFormUI.Views.Layouts"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!--App Title-->
        <TextBlock Text="Design App"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="55 0 0 2"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="Crimson" />
        <icons:PackIconMaterial Kind="Message"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="33 0 0 4"
                               Width="14"
                               Height="14"
                               Foreground="#FF9D00" />
        <icons:PackIconMaterial Kind="Message"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="30 4 0 0"
                               Width="14"
                               Height="14"
                               Foreground="#4880FF" />

        <!--Top Menu-->
        <StackPanel Orientation="Horizontal"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Margin="0 0 15 0">
            <TextBlock Text="Hey Arvin, you are in dashboard"
                       Foreground="#374655"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Margin="0 0 65 0" />

            <Button Style="{StaticResource menuButton}">
                <icons:PackIconMaterial Kind="BellOutline"
                                       Width="14"
                                       Height="14" />
            </Button>

            <Button Style="{StaticResource menuButton}">
                <icons:PackIconMaterial Kind="LayersOutline"
                                       Width="14"
                                       Height="14" />
            </Button>

            <Button Style="{StaticResource menuButton}"
                    Background="#efefef">
                <icons:PackIconMaterial Kind="AccountCheckOutline"
                                       Width="14"
                                       Height="14" />
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
