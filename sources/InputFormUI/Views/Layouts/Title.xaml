<UserControl x:Class="InputFormUI.Views.Layouts.Title"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InputFormUI.Views.Layouts"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
       
        <!--Title Menu-->
        <StackPanel Orientation="Horizontal"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Margin="0 0 15 0">


            <Button Style="{StaticResource menuButton}">
                <icons:PackIconMaterial Kind="BellOutline"
                                       Width="14"
                                       Height="14" />
            </Button>

            <Button Style="{StaticResource menuButton}">
                <icons:PackIconMaterial Kind="LayersOutline"
                                       Width="14"
                                       Height="14" />
            </Button>

            <Button Style="{StaticResource menuButton}">
                <icons:PackIconMaterial Kind="AccountCheckOutline"
                                       Width="14"
                                       Height="14" />
            </Button>

            <Button Style="{StaticResource menuButton}"
                    x:Name="closeButton"
                    ToolTip="Exit App"
                    Cursor="Hand"
                    Background="#efefef" Click="CloseButton_Click">
                <icons:PackIconMaterial Kind="Close"
                                        Width="14"
                                        Height="14" />
            </Button>
            
        </StackPanel>

    </Grid>
</UserControl>
