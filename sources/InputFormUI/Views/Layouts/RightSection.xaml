<UserControl x:Class="InputFormUI.Views.Layouts.RightSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InputFormUI.Views.Layouts"
             xmlns:controls="clr-namespace:InputFormUI.Controls">
    
    <Border
            Background="Tomato"
            CornerRadius="0 0 5 0">
        <StackPanel Margin="60 0 10 0">

            <!--Main Image-->
            <Border CornerRadius="100"
                    Width="85"
                    Height="85"
                    Background="#ffffff"
                    Margin="15 40 20 20">
                <Ellipse Width="80"
                         Height="80">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/Resources/Icons/Vector1.png"
                                    Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Border>

            <!--Section Description-->
            <TextBlock Foreground="#ffffff"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       FontSize="20"
                       Text="Business Details" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="#E6E8EC"
                       FontSize="13"
                       Margin="40 15 40 20"
                       LineHeight="24"
                       FontWeight="Light"
                       TextAlignment="Center"
                       Text="Manage your business info here. Please verify you have completed below mentioned" />

            <!--Cards-->
            <controls:DetailCard Title="Payment Gateways"
                           Time="3 min"
                           Number="1"
                           Image="/Resources/Icons/Vector1.png"
                           IsActive="True" />
            <controls:DetailCard Title="Integration"
                           Time="5 min"
                           Number="2"
                           Image="/Resources/Icons/Vector2.png" />
            <controls:DetailCard Title="Tax"
                           Time="2 min"
                           Number="3"
                           Image="/Resources/Icons/Vector3.png" />
            <controls:DetailCard Title="Policies"
                           Time="1 min"
                           Number="4"
                           Image="/Resources/Icons/Vector4.png" />
            <controls:DetailCard Title="Shipping"
                           Time="1 min"
                           Number="5"
                           Image="/Resources/Icons/Vector5.png" />

        </StackPanel>
    </Border>
</UserControl>
