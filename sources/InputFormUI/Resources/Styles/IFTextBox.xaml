<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:InputFormUI.Controls"
                    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    
    <Style TargetType="{x:Type controls:IFTextBox}">

        <!-- Default Properties -->
        <Setter Property="Height"
                Value="44" />
        <Setter Property="Background"
                Value="#FFFFFF" />
        <Setter Property="Foreground"
                Value="#263238" />
        <Setter Property="BorderBrush"
                Value="#DCE2E8" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="SelectionTextBrush"
                Value="#FFFFFF" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:IFTextBox}">

                    <Grid SnapsToDevicePixels="True">

                        <!-- Main Border -->
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <Border x:Name="FocusBorder"
                                Background="Transparent"
                                BorderBrush="#FFFF6347"
                                BorderThickness="1.5"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">

                            <Border.Effect>
                                <DropShadowEffect Color="#FFFF6347"
                                                  BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.22" />
                            </Border.Effect>
                        </Border>

                        <!-- Input Content -->
                        <Grid>

                            <!-- Icon -->
                            <icons:PackIconMaterial x:Name="PART_Icon"
                                                    Kind="{TemplateBinding Icon}"
                                                    Width="17"
                                                    Height="17"
                                                    Foreground="{TemplateBinding IconBrush}"
                                                    Margin="14,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">

                                <icons:PackIconMaterial.RenderTransform>
                                    <ScaleTransform x:Name="IconScale"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                </icons:PackIconMaterial.RenderTransform>

                                <icons:PackIconMaterial.RenderTransformOrigin>
                                    0.5,0.5
                                </icons:PackIconMaterial.RenderTransformOrigin>
                            </icons:PackIconMaterial>

                            <!-- Placeholder -->
                            <TextBlock x:Name="PART_Placeholder"
                                       Text="{TemplateBinding Placeholder}"
                                       Foreground="{TemplateBinding PlaceholderBrush}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       VerticalAlignment="Center"
                                       Margin="42,0,12,0"
                                       IsHitTestVisible="False"
                                       Opacity="0">

                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="PlaceholderTransform"
                                                        X="-4" />
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- Editable Text -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="42,0,12,0"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>

                    </Grid>

                    <!-- Visual States -->
                    <ControlTemplate.Triggers>

                        <Trigger Property="Text"
                                 Value="">

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Placeholder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="PlaceholderTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Placeholder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />

                                        <DoubleAnimation Storyboard.TargetName="PlaceholderTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="-4"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>

                        </Trigger>

                        <!-- Mouse Hover -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="MainBorder"
                                    Property="BorderBrush"
                                    Value="#FFB9A9A5" />
                        </Trigger>

                        <!-- Keyboard Focus -->
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">

                            <Setter TargetName="MainBorder"
                                    Property="BorderBrush"
                                    Value="#FFFF6347" />

                            <Setter TargetName="PART_Icon"
                                    Property="Foreground"
                                    Value="#FFFF6347" />

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="FocusBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.12"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.12"
                                                         Duration="0:0:0.18" />

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="FocusBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>

                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="MainBorder"
                                    Property="Background"
                                    Value="#F1F3F5" />

                            <Setter TargetName="MainBorder"
                                    Property="BorderBrush"
                                    Value="#E1E5E9" />

                            <Setter TargetName="PART_Icon"
                                    Property="Opacity"
                                    Value="0.4" />

                            <Setter TargetName="PART_Placeholder"
                                    Property="Opacity"
                                    Value="0.6" />

                            <Setter Property="Foreground"
                                    Value="#9AA3AD" />

                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    

</ResourceDictionary>