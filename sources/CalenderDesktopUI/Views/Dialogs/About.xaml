<Window x:Class="CalendarDesktopUI.Views.Dialogs.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="http://schemas.fontawesome.io/icons/"
        xmlns:controls="clr-namespace:CalendarDesktopUI.Controls"
        mc:Ignorable="d"
        Title="About"
        Height="550"
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <!-- Main Card -->
    <Border 
            x:Name="MainBorder"
            Background="{DynamicResource WindowBackColor}"
            Margin="10"
            Opacity="0"
            BorderBrush="{DynamicResource PrimaryColor}"
            BorderThickness="2"
            RenderTransformOrigin="0.5,0.5"
            CornerRadius="20">

        <Border.RenderTransform>

            <TranslateTransform Y="15" />

        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="35"
                              ShadowDepth="0"
                              Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="*" />
                <RowDefinition Height="105" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>
            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="25,0,15,0">

                    <icons:FontAwesome VerticalAlignment="Center" HorizontalAlignment="Left" Icon="User" Foreground="{DynamicResource PrimaryLightColor}" FontSize="24" />
                    <TextBlock Text="About Developer"
                               FontSize="21"
                               Margin="30,0,0,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryLightColor}"
                               VerticalAlignment="Center" />

                    <Button Style="{StaticResource CloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click">
                </Button>
            </Grid>
            <!-- Main Content -->
            <Grid Grid.Row="1"
                  Margin="45,10,45,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Application Image -->
                <Grid Grid.Column="0"
                      VerticalAlignment="Center">
                    <Border Width="170"
                            Height="170"
                            CornerRadius="25">
                        <!--<Image Source="/Assets/about.png"
                               Stretch="Uniform"
                               Margin="25" />-->
                    </Border>
                </Grid>
                <!-- Application Information -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="35,0,0,0">
                    <TextBlock Text="Calendar Desktop"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextColor}" />
                    <TextBlock Text="Version 1.0.0"
                               FontSize="14"
                               Margin="0,6,0,18"
                               Foreground="{DynamicResource PrimaryLightColor}" />
                    <TextBlock Text="A simple and modern desktop calendar application."
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="23"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               MaxWidth="430" />
                    <Border Height="1"
                            Background="#EEEEEE"
                            Margin="0,20,0,15" />
                    <TextBlock Text="Developed by Your Name"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextColor}" />
                    <TextBlock Text="© 2026 Your Company"
                               FontSize="13"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryTextColor}" />
                </StackPanel>
            </Grid>
            <!-- Social Links -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <!-- GitHub -->
                <Button Style="{StaticResource SocialButtonStyle}"
                        Click="GithubButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <icons:ImageAwesome Icon="Github"
                                         Width="20"
                                         Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryLightColor}" />
                        <TextBlock Text="GitHub"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextColor}" />
                    </StackPanel>
                </Button>
                <!-- Instagram -->
                <Button Style="{StaticResource SocialButtonStyle}"
                        Click="InstagramButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <icons:ImageAwesome Icon="Instagram"
                                         Width="20"
                                         Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryLightColor}" />
                        <TextBlock Text="Instagram"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextColor}" />
                    </StackPanel>
                </Button>
                <!-- Gmail / Email -->
                <Button Style="{StaticResource SocialButtonStyle}"
                        Click="EmailButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <icons:ImageAwesome Icon="Envelope"
                                         Width="20"
                                         Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryLightColor}" />
                        <TextBlock Text="Email"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextColor}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Footer  -->
            <Border Grid.Row="3"
                    Background="#FAFAFA"
                    CornerRadius="0,0,20,20"
                    Padding="30,15">
                <Grid>
                    <TextBlock Text="Thank you for using our application."
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               FontSize="12" />

                    <controls:CDButton Content="Close"
                                       Margin="0,0,210,0"
                                       Padding="25,10"
                                       Width="100"
                                       Icon="Close"
                                       Background="DarkGray"
                                       HorizontalAlignment="Right"
                                       Click="CloseButton_Click" />

                    <controls:CDButton Content="Support Developer"
                                       Padding="25,10"
                                       Width="200"
                                       Icon="Heart"
                                       Background="{DynamicResource PrimaryLightColor}"
                                       HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>