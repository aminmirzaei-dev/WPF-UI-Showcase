<Window x:Class="CalendarDesktopUI.Views.Dialogs.Exit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:CalendarDesktopUI.Controls"
        xmlns:icons="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="ExitApp"
        Width="450"
        Height="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="OrangeBrush"
                         Color="#FF7A00" />
        <SolidColorBrush x:Key="OrangeDarkBrush"
                         Color="#E85D04" />
        <SolidColorBrush x:Key="OrangeLightBrush"
                         Color="#FFF3E8" />
        <SolidColorBrush x:Key="TextBrush"
                         Color="#252525" />
        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#777777" />
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="White"
            CornerRadius="20"
            Margin="10"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">


        <Border.RenderTransform>

            <TranslateTransform Y="15" />

        </Border.RenderTransform>


        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="50" />

                <RowDefinition Height="*" />

            </Grid.RowDefinitions>


            <!-- TOP BAR-->

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="Window_MouseLeftButtonDown">


                <!-- Close Button -->

                <Button Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click">

                </Button>

            </Grid>


            <!-- CONTENT  -->

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">


                <!-- Exit Icon -->

                <Border Width="65"
                        Height="65"
                        CornerRadius="32.5"
                        Background="Gray"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">

                    <icons:FontAwesome Icon="Close"
                                     FontSize="28"
                                     Foreground="{StaticResource OrangeBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

                </Border>


                <!--Title-->

                <TextBlock Text="Do you want to exit the app?"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />


                <!-- Sub Title -->

                <TextBlock Text="Are you sure you want to exit the application?"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,7,0,18"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />


                <!-- Buttons -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">


                    <!-- NO -->

                    <controls:CDButton Content="No"
                                       Width="120"
                                       Height="40"
                                       Icon="Close"
                                       Margin="0,0,8,0"
                                       Background="{StaticResource OrangeDarkBrush}"
                                       Click="NoButton_Click" />


                    <!-- YES-->

                    <controls:CDButton Content="Yes"
                                       Width="120"
                                       Height="40"
                                       Icon="PowerOff"
                                       Background="#EF4444"
                                       Foreground="White"
                                       Click="YesButton_Click" />

                </StackPanel>

            </StackPanel>

        </Grid>

    </Border>

</Window>