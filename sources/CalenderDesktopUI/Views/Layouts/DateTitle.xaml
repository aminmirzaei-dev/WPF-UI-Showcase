<UserControl x:Class="CalendarDesktopUI.Views.Layouts.DateTitle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CalendarDesktopUI.Views.Layouts"
             xmlns:icons="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" >
    
    <StackPanel Margin="30 45 30 10"
                Orientation="Horizontal">
        <TextBlock Text="16"
                   FontSize="50"
                   Foreground="#FFFFFF" />

        <StackPanel Grid.Column="1"
                    Margin="10 0 0 0"
                    VerticalAlignment="Center">
            <TextBlock Text="November"
                       Foreground="#FFFFFF"
                       FontSize="24" />
            <TextBlock Text="Monday"
                       Foreground="WhiteSmoke"
                       FontSize="14" />
        </StackPanel>

        <Button Style="{StaticResource BigButton}"
                Margin="112 0 5 0">
            <icons:ImageAwesome Icon="AngleLeft"
                                Style="{StaticResource BigAngle}" />
        </Button>

        <Button Style="{StaticResource BigButton}">
            <icons:ImageAwesome Icon="AngleRight"
                                Style="{StaticResource BigAngle}" />
        </Button>
    </StackPanel>
</UserControl>
