<UserControl x:Class="CalendarDesktopUI.Views.Layouts.AddNotes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CalendarDesktopUI.Views.Layouts"
             xmlns:icons="http://schemas.fontawesome.io/icons/"
             xmlns:controls="clr-namespace:CalendarDesktopUI.Controls">
    <StackPanel>

        <TextBlock Text="5 tasks- 2 dates left"
                   Foreground="WhiteSmoke"
                   FontSize="16"
                   Margin="35 0 20 0" />

        <!--Add Notes-->
        <Border Background="{DynamicResource PanelBackColor}"
                CornerRadius="10"
                HorizontalAlignment="Center"
                Width="355"
                Margin="0 30 0 20"
                Padding="17 15 5 15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <icons:ImageAwesome Icon="Pencil"
                                         Width="15"
                                         Height="15"
                                         Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock x:Name="lblNote"
                                   Text="Add Note"
                                   Style="{StaticResource TextHint}" />
                        <TextBox Name="txtNote"
                                 Style="{StaticResource LiteTextBox}" />
                    </Grid>

                    <Separator Margin="0 12 0 11"
                               Background="{DynamicResource PrimaryLightColor}"
                               Height="0.8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <icons:ImageAwesome Icon="Bell"
                                         Width="15"
                                         Height="15"
                                         Foreground="{DynamicResource PrimaryColor}" />
                        <TextBlock x:Name="lblTime"
                                   Text="_ _ : _ _  -  _ _ : _ _"
                                   Style="{StaticResource TextHint}" />
                        <TextBox Name="txtTime"
                                 Style="{StaticResource LiteTextBox}" />
                    </Grid>

                </StackPanel>

                <Button Style="{StaticResource YearButton}"
                        Grid.Column="1">
                    <icons:ImageAwesome Icon="PlusCircle"
                                     Width="28"
                                     Height="28"
                                     Foreground="{DynamicResource PrimaryColor}" />
                </Button>
            </Grid>
        </Border>

        <!--Notes-->
        <controls:TaskItem Title="Post on social networks"
                 Time="09:45 - 10:30"
                 Color="WhiteSmoke"
                 Icon="CheckCircle"
                 IconBell="BellSlash" />
        <controls:TaskItem Title="Review the app design"
                 Time="11:30 - 12:00"
                 Color="WhiteSmoke"
                 Icon="CheckCircle"
                 IconBell="BellSlash" />
        <controls:TaskItem Title="Build a demo of the app"
                 Time="14:00 - 15:30"
                 Color="White"
                 Icon="CircleThin"
                 IconBell="Bell" />
        <controls:TaskItem Title="Dinner with John Doe"
                 Time="20:15 - 21:45"
                 Color="White"
                 Icon="CircleThin"
                 IconBell="Bell" />
        <controls:TaskItem Title="Send email to Amin Mirzaei"
                 Time="23:00 - 23:20"
                 Color="White"
                 Icon="CircleThin"
                 IconBell="Bell" />

    </StackPanel>
</UserControl>
