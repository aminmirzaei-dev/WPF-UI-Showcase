<Window x:Class="CalendarDesktopUI.Views.Windows.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalendarDesktopUI.Views.Windows"
        xmlns:icons="http://schemas.fontawesome.io/icons/"
        xmlns:controls="clr-namespace:CalendarDesktopUI.Controls"
        xmlns:layouts="clr-namespace:CalendarDesktopUI.Views.Layouts"
        FontFamily="Trebuchet MS"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="620"
        Width="900">
    <Grid>

        <!--Grid Background-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="20 0 0 20"
                    Background="White" />

            <Border CornerRadius="0 20 20 0"
                    Grid.Column="1"
                    Background="Tomato" />
        </Grid>

        <!--Grid Controls-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <layouts:DateSelection></layouts:DateSelection>

            <StackPanel Grid.Column="1">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,15,0">

                    <Button Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,10,15,0"
                            Content="User"
                            Click="AboutButton_Click"
                            Style="{StaticResource TitleButtonStyle}">
                    </Button>

                    <Button Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,10,15,0"
                            Content="PaintBrush"
                            Click="AppearanceButton_Click"
                            Style="{StaticResource TitleButtonStyle}">
                    </Button>
                    
                    <Button Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,10,15,0"
                            Click="CloseButton_Click"
                            Content="Close"
                            Style="{StaticResource TitleButtonStyle}">

                    </Button>
                </StackPanel>

                <!--Titles-->
                <layouts:DateTitle></layouts:DateTitle>

                <!--Add Notes-->
                <layouts:AddNotes></layouts:AddNotes>

            </StackPanel>
        </Grid>

        <!-- Overlay -->
        <Border x:Name="DialogOverlay"
                Background="#80000000"
                Visibility="Collapsed"
                Panel.ZIndex="999" />

    </Grid>
</Window>
