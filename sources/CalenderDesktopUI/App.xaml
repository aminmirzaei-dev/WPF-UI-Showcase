<Application x:Class="CalendarDesktopUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CalendarDesktopUI"
             xmlns:services="clr-namespace:CalendarDesktopUI.Services"
             StartupUri="Views/Windows/Main.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <services:ThemeService x:Key="ThemeService" />
            <services:PaletteService x:Key="PaletteService" />


            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBlocks.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBoxs.xaml" />
                <ResourceDictionary Source="Resources/Styles/IconImages.xaml" />
                <ResourceDictionary Source="/Resources/Styles/CDCalendarStyles.xaml" />
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Palettes/Red.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
