<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CalendarDesktopUI.Controls"
                    xmlns:icons="http://schemas.fontawesome.io/icons/">


    <Style x:Key="ColorOptionStyle"
           TargetType="RadioButton">

        <Setter Property="Width"
                Value="62" />

        <Setter Property="Height"
                Value="62" />

        <Setter Property="Margin"
                Value="0,0,17,0" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="RadioButton">

                    <Grid>

                        <!-- Outer selection ring -->

                        <Ellipse x:Name="SelectionRing"
                                 Width="62"
                                 Height="62"
                                 Fill="Transparent"
                                 Stroke="{DynamicResource PrimaryBrush}"
                                 StrokeThickness="2"
                                 Visibility="Collapsed" />


                        <!-- Color -->

                        <Ellipse x:Name="ColorCircle"
                                 Width="50"
                                 Height="50"
                                 Fill="{TemplateBinding Tag}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />


                        <!-- Check -->

                        <TextBlock x:Name="CheckIcon"
                                   Text="✓"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />

                    </Grid>


                    <ControlTemplate.Triggers>

                        <!-- Hover -->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ColorCircle"
                                    Property="Opacity"
                                    Value="0.78" />

                        </Trigger>


                        <!-- Selected -->

                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Setter TargetName="SelectionRing"
                                    Property="Visibility"
                                    Value="Visible" />

                            <Setter TargetName="CheckIcon"
                                    Property="Visibility"
                                    Value="Visible" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>



    <Style x:Key="ThemeOptionStyle"
           TargetType="RadioButton">

        <Setter Property="Width"
                Value="155" />

        <Setter Property="Height"
                Value="105" />

        <Setter Property="Margin"
                Value="0,0,15,0" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Background"
                Value="#FFFFFF" />

        <Setter Property="Foreground"
                Value="#333333" />

        <Setter Property="RenderTransformOrigin"
                Value="0.5,0.5" />

        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1"
                                ScaleY="1" />
            </Setter.Value>
        </Setter>


        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="RadioButton">

                    <Grid>

                        <!-- Main Border -->

                        <Border x:Name="ThemeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#EEEEEE"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="12">

                            <Border.Effect>

                                <DropShadowEffect x:Name="ThemeShadow"
                                                  BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.08"
                                                  Color="Black" />

                            </Border.Effect>


                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="68" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>


                                <!-- Theme Preview -->

                                <Border x:Name="ThemePreview"
                                        Width="125"
                                        Height="62"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        CornerRadius="9"
                                        RenderTransformOrigin="0.5,0.5">

                                    <Border.RenderTransform>

                                        <ScaleTransform ScaleX="1"
                                                        ScaleY="1" />

                                    </Border.RenderTransform>


                                    <Grid Margin="7">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="9" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>


                                        <!-- Fake Header -->

                                        <Border Grid.Row="0"
                                                CornerRadius="3"
                                                Background="#FF7A00"
                                                Opacity="0.9" />


                                        <!-- Fake Content -->

                                        <Grid Grid.Row="1"
                                              Margin="0,5,0,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="25" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>


                                            <Border Grid.Column="0"
                                                    CornerRadius="2"
                                                    Background="#DADADA"
                                                    Opacity="0.7" />


                                            <StackPanel Grid.Column="1"
                                                        Margin="6,0,0,0">

                                                <Border Height="5"
                                                        Width="45"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="2"
                                                        Background="#AAAAAA"
                                                        Opacity="0.7" />

                                                <Border Height="4"
                                                        Width="32"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,4,0,0"
                                                        CornerRadius="2"
                                                        Background="#CCCCCC"
                                                        Opacity="0.7" />

                                            </StackPanel>

                                        </Grid>

                                    </Grid>

                                </Border>


                                <!-- Title -->

                                <TextBlock Grid.Row="1"
                                           Text="{TemplateBinding Content}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}" />

                            </Grid>

                        </Border>


                        <!-- Selected Indicator -->

                        <Border x:Name="SelectedGlow"
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,8,8,0"
                                CornerRadius="10"
                                Background="{DynamicResource PrimaryBrush}"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>

                                <ScaleTransform ScaleX="0.3"
                                                ScaleY="0.3" />

                            </Border.RenderTransform>

                        </Border>

                    </Grid>


                    <ControlTemplate.Triggers>


                        <!-- Hoverr-->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <!-- Card Scale -->

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.035"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.035"
                                                         Duration="0:0:0.15" />


                                        <!-- Preview Scale -->

                                        <DoubleAnimation Storyboard.TargetName="ThemePreview"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.04"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="ThemePreview"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.04"
                                                         Duration="0:0:0.18" />


                                        <!-- Shadow -->

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="20"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.16"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="ShadowDepth"
                                                         To="4"
                                                         Duration="0:0:0.18" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>


                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="0:0:0.15" />


                                        <DoubleAnimation Storyboard.TargetName="ThemePreview"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="ThemePreview"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="0:0:0.15" />


                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="12"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="ShadowDepth"
                                                         To="2"
                                                         Duration="0:0:0.15" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.ExitActions>


                            <Setter TargetName="ThemeBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}" />

                        </Trigger>


                        <!--Selected -->

                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Setter TargetName="ThemeBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}" />

                            <Setter TargetName="ThemeBorder"
                                    Property="BorderThickness"
                                    Value="2" />


                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>


                                        <!-- Selected Card Scale -->

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.025"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.025"
                                                         Duration="0:0:0.18" />


                                        <!-- Glow -->

                                        <DoubleAnimation Storyboard.TargetName="SelectedGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2" />

                                        <DoubleAnimation Storyboard.TargetName="SelectedGlow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1"
                                                         Duration="0:0:0.2" />

                                        <DoubleAnimation Storyboard.TargetName="SelectedGlow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="0:0:0.2" />


                                        <!-- Selected Shadow -->

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="22"
                                                         Duration="0:0:0.2" />

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.18"
                                                         Duration="0:0:0.2" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>


                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="SelectedGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="SelectedGlow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.3"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="SelectedGlow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.3"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="BlurRadius"
                                                         To="12"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="ThemeShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08"
                                                         Duration="0:0:0.15" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.ExitActions>

                        </Trigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <Style x:Key="SocialButtonStyle"
           TargetType="Button">
        <Setter Property="Width"
                Value="150" />
        <Setter Property="Height"
                Value="48" />
        <Setter Property="Margin"
                Value="5,0" />
        <Setter Property="Background"
                Value="#F8F8F8" />
        <Setter Property="BorderBrush"
                Value="#EEEEEE" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#FFF3E8" />
                            <Setter Property="BorderBrush"
                                    Value="#FF7A00" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#FFE5D2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:CDButton}">

        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="Background"
                Value="#6655D8" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="18,10" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:CDButton}">

                    <ControlTemplate.Resources>

                        <SolidColorBrush x:Key="HoverBrush"
                                         Color="#7565E5" />

                        <SolidColorBrush x:Key="PressedBrush"
                                         Color="#5748C2" />

                        <Storyboard x:Key="MouseOverAnimation">

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.015"
                                             Duration="0:0:0.12" />

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.015"
                                             Duration="0:0:0.12" />

                        </Storyboard>

                        <Storyboard x:Key="MouseLeaveAnimation">

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1"
                                             Duration="0:0:0.12" />

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1"
                                             Duration="0:0:0.12" />

                        </Storyboard>

                    </ControlTemplate.Resources>


                    <Grid>

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                SnapsToDevicePixels="True">

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform"
                                                ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                            <Border.RenderTransformOrigin>
                                0.5,0.5
                            </Border.RenderTransformOrigin>

                            <Border.Effect>

                                <DropShadowEffect x:Name="ShadowEffect"
                                                  BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.20" />

                            </Border.Effect>


                            <Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <!--Icon-->

                                    <icons:FontAwesome x:Name="IconElement"
                                                     Icon="{TemplateBinding Icon}"
                                                     FontSize="{TemplateBinding FontSize}"
                                                     Foreground="{TemplateBinding Foreground}"
                                                     VerticalAlignment="Center"
                                                     Margin="5,0,10,0" />

                                    <!-- Text -->

                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>


                    <ControlTemplate.Triggers>

                        <!-- Hover -->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{Binding HoverBackground,
                        RelativeSource={RelativeSource TemplatedParent}}" />

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.015"
                                                         Duration="0:0:0.12" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.015"
                                                         Duration="0:0:0.12" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Pressed -->

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.88" />

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97"
                                                         Duration="0:0:0.06" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97"
                                                         Duration="0:0:0.06" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.08" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.08" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Disabled -->

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.45" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="TitleButtonStyle"
           TargetType="Button">

        <Setter Property="Width"
                Value="36" />
        <Setter Property="Height"
                Value="36" />
        <Setter Property="Background"
                Value="White" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Foreground"
                Value="Tomato" />
        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="18">

                        <icons:ImageAwesome Icon="{Binding Content,
                                       RelativeSource={RelativeSource TemplatedParent}}"
                                            Width="15"
                                            Height="15"
                                            Foreground="{TemplateBinding Foreground}" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter Property="Background"
                                    Value="#FFF0E5" />

                            <Setter Property="Foreground"
                                    Value="#FF7A00" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="CloseButtonStyle"
           TargetType="Button">
        <Setter Property="Width"
                Value="36" />
        <Setter Property="Height"
                Value="36" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Foreground"
                Value="#777777" />
        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Content">
            <Setter.Value>
                <icons:ImageAwesome Icon="Close"
                                    Width="15"
                                    Height="15"
                                    Foreground="Tomato" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#FFF0E5" />
                            <Setter Property="Foreground"
                                    Value="#FF7A00" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:MenuButtonItem}">

        <Setter Property="Background"
                Value="White" />
        
        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MenuButtonItem}">

                    <Border Background="{TemplateBinding Background}"
                            Padding="10,5"
                            BorderThickness="0"
                            Width="140">

                        <StackPanel Orientation="Horizontal">

                            <icons:ImageAwesome Icon="{Binding Icon,
                                   RelativeSource={RelativeSource TemplatedParent}}"
                                                Width="13"
                                                Height="13"
                                                Foreground="Black"
                                                Margin="5,0,20,0" />

                            <TextBlock Text="{Binding Caption,
                                   RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="Black"
                                       FontSize="14" />

                        </StackPanel>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#e9e9e9" />
            </Trigger>
        </Style.Triggers>

    </Style>


    <Style x:Key="YearButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="#BABABA" />
        <Setter Property="FontSize"
                Value="22" />
        <Setter Property="Margin"
                Value="12 0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Foreground"
                        Value="#C73F69" />
            </Trigger>
            <Trigger Property="IsMouseCaptured"
                     Value="True">
                <Setter Property="Foreground"
                        Value="#8a2b42" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MonthButton"
           TargetType="Button"
           BasedOn="{StaticResource YearButton}">
        <Setter Property="FontSize"
                Value="18" />
    </Style>

    <Style x:Key="BigButton"
           TargetType="Button"
           BasedOn="{StaticResource YearButton}">
        <Setter Property="Foreground"
                Value="Orange" />
    </Style>

</ResourceDictionary>