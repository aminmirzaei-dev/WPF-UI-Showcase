<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackColor">White</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackColor">WhiteSmoke</SolidColorBrush>
    <SolidColorBrush x:Key="TextColor" Color="#252525" />
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#777777" />
    <SolidColorBrush x:Key="HoverBackColor"
                     Color="White" />
    <SolidColorBrush x:Key="PressBackColor"
                     Color="WhiteSmoke" />


</ResourceDictionary>