<UserControl x:Class="ChatAppUI.Controls.MenuButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChatAppUI.Controls"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             Cursor="Hand"
             Name="menuButton" d:DesignWidth="200">
    <Grid Margin="0 -17">
        <Grid HorizontalAlignment="Right"
              Width="20"
              Height="85"
              Panel.ZIndex="1"
              Visibility="{Binding ElementName=btn,Path=Tag}">
        </Grid>

        <Button x:Name="mainButton"
                Style="{StaticResource menuButton}">
            <StackPanel Orientation="Horizontal">
                <icon:PackIconMaterial Kind="{Binding ElementName=menuButton,Path=Icon}"
                                       Style="{StaticResource menuButtonIcon}" />
                <TextBlock Text="{Binding ElementName=menuButton,Path=Title}"
                           Style="{StaticResource menuButtonText}" />
            </StackPanel>
        </Button>

    </Grid>
</UserControl>
