<UserControl x:Class="TVSettingsUI.Pages.Options"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TVSettingsUI.Pages"
             xmlns:controls="clr-namespace:TVSettingsUI.Controls">
    
    <Grid Margin="20" x:Name="grid">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto" Padding="0 20" VerticalAlignment="Center" Width="{Binding ElementName=grid,Path=ActualWidth}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <controls:TVElement Title="{Binding [NetworkSettings],
           Source={StaticResource LanguageService},
           Mode=OneWay}" Icon="Wifi" ElementClick="NetworkSetting_ElementClick"/>
                <controls:TVElement Title="{Binding [TimeSettings],
           Source={StaticResource LanguageService},
           Mode=OneWay}" IsActive="True" Icon="Timelapse" ElementClick="Time_ElementClick"/>
                <controls:TVElement Title="{Binding [StorageAnalysis],
           Source={StaticResource LanguageService},
           Mode=OneWay}" Icon="Harddisk" ElementClick="Storage_ElementClick"/>
                <controls:TVElement Title="{Binding [Common],
Source={StaticResource LanguageService},
Mode=OneWay}"
                                    Icon="Layers"
                                    ElementClick="Common_ElementClick" />
                <controls:TVElement Title="{Binding [AboutUs],
           Source={StaticResource LanguageService},
           Mode=OneWay}" Icon="Information" ElementClick="About_ElementClick"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
