<Application x:Class="TVSettingsUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TVSettingsUI"
             xmlns:services="clr-namespace:TVSettingsUI.Services"
             StartupUri="Views/Windows/Main.xaml">
    <Application.Resources>
        <ResourceDictionary>
            
            <services:LanguageService
                x:Key="LanguageService" />

            <services:ThemeService
                x:Key="ThemeService" />
            
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/TVButtons.xaml"/>
                <ResourceDictionary Source="Resources/Styles/TVTextBlocks.xaml" />
                <ResourceDictionary Source="Resources/Styles/TVScrollBars.xaml" />
                <ResourceDictionary Source="Resources/Themes/Blue.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
