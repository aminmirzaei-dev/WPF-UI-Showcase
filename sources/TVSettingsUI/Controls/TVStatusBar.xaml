<UserControl x:Class="TVSettingsUI.Controls.TVStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TVSettingsUI.Controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" >
    
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 15 15 0">
        <TextBlock Text="05:34" Foreground="{DynamicResource StatusBarTitleColor}" FontSize="28" VerticalAlignment="Center"/>
        <StackPanel Margin="13 0" VerticalAlignment="Center">
            <TextBlock Text="Nov, 17" Foreground="{DynamicResource StatusBarDateColor}" FontSize="10"/>
            <TextBlock Text="Tuesday" Foreground="{DynamicResource StatusBarDateColor}" FontSize="10"/>
        </StackPanel>
        <icons:PackIconMaterial Kind="Wifi" Foreground="{DynamicResource StatusBarTitleColor}" Width="25" Height="25" VerticalAlignment="Center"/>
    </StackPanel>
    
</UserControl>
