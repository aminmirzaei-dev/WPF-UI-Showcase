<UserControl x:Class="TVSettingsUI.Controls.TVToggleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TVSettingsUI.Controls"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             Name="tvToggleButton"
             MinWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border  CornerRadius="5" Padding="20" Margin="0 5">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#2E3967" />

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#6077F7" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <icon:PackIconMaterial Kind="{Binding ElementName=tvToggleButton,Path=Icon}" Foreground="White" Width="30" Height="30" 
        VerticalAlignment="Center" HorizontalAlignment="Left"/>
            
            
            <TextBlock Text="{Binding ElementName=tvToggleButton,Path=Title}" Foreground="#FCF9F4" FontSize="24" 
           FontWeight="Light" VerticalAlignment="Center" Margin="50 0 0 2"/>

            <CheckBox Style="{StaticResource TVToggleButton}" IsChecked="{Binding ElementName=tvToggleButton,Path=IsChecked}"
          Visibility="{Binding ElementName=tvToggleButton,Path=HasToggle,Converter={StaticResource BoolToVis}}"/>

            <TextBlock Visibility="{Binding ElementName=tvToggleButton,Path=HasText,Converter={StaticResource BoolToVis}}" 
           Text="{Binding ElementName=tvToggleButton,Path=Text}" HorizontalAlignment="Right" Foreground="#FCF9F4" 
           FontSize="24" FontWeight="Light" VerticalAlignment="Center" Margin="0 0 10 2"/>
        </Grid>

    </Border>
</UserControl>
