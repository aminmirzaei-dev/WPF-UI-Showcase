<UserControl x:Class="TVSettingsUI.Controls.TVElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TVSettingsUI.Controls"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             Name="tvElement">

    <Button Padding="20"
            Width="230"
            Margin="15 0"
            Style="{StaticResource TVElementButton}"
            FocusVisualStyle="{x:Null}"
            Click="ParentButton_Click">


        <StackPanel VerticalAlignment="Center">
            <icon:PackIconMaterial Kind="{Binding ElementName=tvElement,Path=Icon}"
                                   Width="50"
                                   Height="50"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />

            <TextBlock Text="{Binding ElementName=tvElement,Path=Title}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Margin="0 30 0 0" />
        </StackPanel>

    </Button>
</UserControl>
