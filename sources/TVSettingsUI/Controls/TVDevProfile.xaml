<UserControl x:Class="TVSettingsUI.Controls.TVDevProfile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TVSettingsUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="500">
    <StackPanel Orientation="Horizontal">
        <Ellipse Width="100"
                 Height="100">
            <Ellipse.Fill>
                <ImageBrush ImageSource="/Images/Developer/DevBlue.png"
                            Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>

        <TextBlock Margin="20,0,0,0" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Created by Amin Mirzaei" Foreground="{DynamicResource PrimaryForegroundColor}" />
    </StackPanel>
</UserControl>
