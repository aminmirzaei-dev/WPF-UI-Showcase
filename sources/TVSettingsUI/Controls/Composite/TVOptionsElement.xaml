<UserControl x:Class="TVSettingsUI.Controls.TVOptionsElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TVSettingsUI.Controls"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             Name="tvOptionsElement"
             MinWidth="300">

    <Border CornerRadius="5"
            Padding="20"
            Margin="0,5">

        <Border.Style>
            <Style TargetType="Border">

                <Setter Property="Background"
                        Value="{DynamicResource ToggleButtonContainerBackColor}" />

                <Style.Triggers>

                    <Trigger Property="IsMouseOver"
                             Value="True">

                        <Setter Property="Background"
                                Value="{DynamicResource ToggleButtonContainerHoverBackColor}" />

                    </Trigger>

                </Style.Triggers>

            </Style>
        </Border.Style>


        <Grid>

            <Grid.ColumnDefinitions>

                <!-- Icon -->
                <ColumnDefinition Width="Auto" />

                <!-- Title -->
                <ColumnDefinition Width="Auto" />

                <!-- Radio Buttons -->
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>


            <!-- Icon -->

            <icon:PackIconMaterial Grid.Column="0"
                                   Kind="{Binding Icon,
                               ElementName=tvOptionsElement}"
                                   Foreground="White"
                                   Width="30"
                                   Height="30"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />


            <!-- Title -->

            <TextBlock Grid.Column="1"
                       Text="{Binding Title,
                               ElementName=tvOptionsElement}"
                       Foreground="#FCF9F4"
                       FontSize="24"
                       FontWeight="Light"
                       VerticalAlignment="Center"
                       Margin="20,0,20,2" />


            <!-- Options -->

            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          CanContentScroll="True">
                
                <ScrollViewer.Resources>

                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource TVHorizontalScrollBar}" />

                </ScrollViewer.Resources>


                <ItemsControl ItemsSource="{Binding Options,
                                          ElementName=tvOptionsElement}">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <StackPanel Orientation="Horizontal" />

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>
</UserControl>
