<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         Primary Colors
         ============================================================ -->

    <SolidColorBrush x:Key="PrimaryColor">#3B82F6</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryHoverColor">#60A5FA</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryActiveColor">#2563EB</SolidColorBrush>

    <SolidColorBrush x:Key="PrimaryBackColor">#253B66</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryHoverBackColor">#31558F</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryActiveBackColor">#3B82F6</SolidColorBrush>

    <SolidColorBrush x:Key="PrimaryBorderColor">#3B82F6</SolidColorBrush>


    <!-- ============================================================
         Background Colors
         ============================================================ -->

    <SolidColorBrush x:Key="WindowBackColor">#16233F</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackColor">#24385F</SolidColorBrush>

    <SolidColorBrush x:Key="ControlBackColor">#2A416D</SolidColorBrush>
    <SolidColorBrush x:Key="ControlHoverBackColor">#345487</SolidColorBrush>


    <!-- ============================================================
         Foreground Colors
         ============================================================ -->

    <SolidColorBrush x:Key="PrimaryForegroundColor">#FFFFFF</SolidColorBrush>

    <SolidColorBrush x:Key="ForegroundColor">#E5E7EB</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryForegroundColor">#CBD5E1</SolidColorBrush>
    <SolidColorBrush x:Key="MutedForegroundColor">#94A3B8</SolidColorBrush>

    <SolidColorBrush x:Key="DisabledForegroundColor">#64748B</SolidColorBrush>


    <!-- ============================================================
         Window Control Buttons
         ============================================================ -->

    <SolidColorBrush x:Key="WindowControlButtonForegroundColor">
        #FFFFFF
    </SolidColorBrush>

    <SolidColorBrush x:Key="WindowControlButtonHoverForegroundColor">
        #D1D5DB
    </SolidColorBrush>


    <!-- ============================================================
         Toggle Button
         ============================================================ -->

    <SolidColorBrush x:Key="ToggleButtonBorderColor">
        #3B82F6
    </SolidColorBrush>

    <SolidColorBrush x:Key="ToggleButtonOnBackColor">
        #3B82F6
    </SolidColorBrush>

    <SolidColorBrush x:Key="ToggleButtonOffBackColor">
        #263A62
    </SolidColorBrush>

    <SolidColorBrush x:Key="ToggleButtonCircleColor">
        #F8FAFC
    </SolidColorBrush>

    <SolidColorBrush x:Key="ToggleButtonContainerBackColor">
        #2A416D
    </SolidColorBrush>

    <SolidColorBrush x:Key="ToggleButtonContainerHoverBackColor">
        #3B6FB6
    </SolidColorBrush>


    <!-- ============================================================
         Element Button
         ============================================================ -->

    <SolidColorBrush x:Key="ElementButtonForegroundColor">
        #E2E8F0
    </SolidColorBrush>

    <SolidColorBrush x:Key="ElementButtonHoverForegroundColor">
        #FFFFFF
    </SolidColorBrush>

    <SolidColorBrush x:Key="ElementButtonHoverBackColor">
        #3569A8
    </SolidColorBrush>

    <SolidColorBrush x:Key="ElementButtonActiveForegroundColor">
        #FFFFFF
    </SolidColorBrush>

    <SolidColorBrush x:Key="ElementButtonActiveBackColor">
        #3B82F6
    </SolidColorBrush>


    <!-- ============================================================
         Text
         ============================================================ -->

    <SolidColorBrush x:Key="TextColor">
        #E5E7EB
    </SolidColorBrush>

    <SolidColorBrush x:Key="TitleTextColor">
        #FFFFFF
    </SolidColorBrush>

    <SolidColorBrush x:Key="SecondaryTextColor">
        #CBD5E1
    </SolidColorBrush>

    <SolidColorBrush x:Key="MutedTextColor">
        #94A3B8
    </SolidColorBrush>


    <!-- ============================================================
         Status Bar
         ============================================================ -->

    <SolidColorBrush x:Key="StatusBarTitleColor">
        #F8FAFC
    </SolidColorBrush>

    <SolidColorBrush x:Key="StatusBarDateColor">
        #CBD5E1
    </SolidColorBrush>


    <!-- ============================================================
         Storage Description
         ============================================================ -->

    <SolidColorBrush x:Key="StorageDescriptionIconColor">
       black
    </SolidColorBrush>

    <SolidColorBrush x:Key="StorageDescriptionTitleColor">
        #FFFFFF
    </SolidColorBrush>


    <!-- ============================================================
         Gradients
         ============================================================ -->

    <!-- Window Background -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">

        <GradientStop Color="#24385F"
                      Offset="0" />

        <GradientStop Color="#16233F"
                      Offset="1" />

    </LinearGradientBrush>


    <!-- Element Button Background -->
    <LinearGradientBrush x:Key="ElementButtonBackgroundBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">

        <GradientStop Color="#344F7D"
                      Offset="0" />

        <GradientStop Color="#263E69"
                      Offset="1" />

    </LinearGradientBrush>


</ResourceDictionary>