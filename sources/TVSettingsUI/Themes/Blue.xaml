<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Button Colors-->
    <SolidColorBrush x:Key="TVWindowControlButtonsForeColor">#ffffff</SolidColorBrush>
    <SolidColorBrush x:Key="TVWindowControlButtonsHoverForeColor">#d0d0d0</SolidColorBrush>

    <!--Toggle Button Colors-->
    <SolidColorBrush x:Key="TVToggleButtonBorderColor">DodgerBlue</SolidColorBrush>
    <SolidColorBrush x:Key="TVToggleButtonOnBackColor">DodgerBlue</SolidColorBrush>
    <SolidColorBrush x:Key="TVToggleButtonOffBackColor">#2B3361</SolidColorBrush>
    <SolidColorBrush x:Key="TVToggleButtonCircleColor">#fbfbfb</SolidColorBrush>


    <!-- Window Gradient Brushes-->
    <LinearGradientBrush x:Key="WindowBackColor"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#2E3967" />
        <GradientStop Color="#192559"
                      Offset="1.0" />
    </LinearGradientBrush>


</ResourceDictionary>