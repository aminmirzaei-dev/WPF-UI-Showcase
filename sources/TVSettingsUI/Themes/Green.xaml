<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Control colors -->
    <Color x:Key="WindowColor">#FFE8F5E9</Color>
    <Color x:Key="ContentAreaColorLight">#FFC8E6C9</Color>
    <Color x:Key="ContentAreaColorDark">#FF66BB6A</Color>
    <Color x:Key="DisabledControlLightColor">#FFE8F5E9</Color>
    <Color x:Key="DisabledControlDarkColor">#FFC8E6C9</Color>
    <Color x:Key="DisabledForegroundColor">#FF888888</Color>
    <Color x:Key="SelectedBackgroundColor">#FFC8E6C9</Color>
    <Color x:Key="SelectedUnfocusedColor">#FFDDDDDD</Color>
    <Color x:Key="ControlLightColor">White</Color>
    <Color x:Key="ControlMediumColor">#FF66BB6A</Color>
    <Color x:Key="ControlDarkColor">#FF2E7D32</Color>
    <Color x:Key="ControlMouseOverColor">#FF43A047</Color>
    <Color x:Key="ControlPressedColor">#FF2E7D32</Color>
    <Color x:Key="GlyphColor">#FF444444</Color>
    <Color x:Key="GlyphMouseOver">#FF1B5E20</Color>

    <!-- Border colors -->
    <Color x:Key="BorderLightColor">#FFCCCCCC</Color>
    <Color x:Key="BorderMediumColor">#FF888888</Color>
    <Color x:Key="BorderDarkColor">#FF444444</Color>
    <Color x:Key="PressedBorderLightColor">#FF888888</Color>
    <Color x:Key="PressedBorderDarkColor">#FF444444</Color>
    <Color x:Key="DisabledBorderLightColor">#FFAAAAAA</Color>
    <Color x:Key="DisabledBorderDarkColor">#FF888888</Color>
    <Color x:Key="DefaultBorderBrushDarkColor">Black</Color>

    <!-- Control-specific resources -->
    <Color x:Key="HeaderTopColor">#FFC8E6C9</Color>
    <Color x:Key="DatagridCurrentCellBorderColor">Black</Color>
    <Color x:Key="SliderTrackDarkColor">#FFC8E6C9</Color>
    <Color x:Key="NavButtonFrameColor">#FF43A047</Color>

    <LinearGradientBrush x:Key="MenuPopupBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="{DynamicResource ControlLightColor}" Offset="0" />
        <GradientStop Color="{DynamicResource ControlMediumColor}" Offset="0.5" />
        <GradientStop Color="{DynamicResource ControlLightColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStopCollection>
            <GradientStop Color="#0000FF00" Offset="0" />
            <GradientStop Color="#6000FF00" Offset="0.4" />
            <GradientStop Color="#6000FF00" Offset="0.6" />
            <GradientStop Color="#0000FF00" Offset="1" />
        </GradientStopCollection>
    </LinearGradientBrush>

</ResourceDictionary>