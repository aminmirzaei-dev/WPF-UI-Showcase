<Window x:Class="TVSettingsUI.Windows.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVSettingsUI.Windows"
        xmlns:pages="clr-namespace:TVSettingsUI.Pages"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:controls="clr-namespace:TVSettingsUI.Controls"
        mc:Ignorable="d"
        Title="TV Settings"
        Height="720" Width="1350" MinHeight="700" MinWidth="650" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Border  CornerRadius="15" MouseLeftButtonDown="Grid_MouseLeftButtonDown" MouseDown="Grid_MouseDown">

        <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#2E3967"/>
                <GradientStop Color="#192559" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Status Bar-->
            <controls:TVStatusBar></controls:TVStatusBar>

            <!--Back Button-->
            <Button Name="backButton" Click="backButton_Click" Style="{StaticResource TVBackButton}">
                <icons:PackIconMaterial Kind="ArrowLeft" Width="25" Height="25"/>
            </Button>

            <!--Close Button-->
            <Button Name="closeButton" Click="closeButton_Click" Style="{StaticResource TVCloseButton}">
                <icons:PackIconMaterial Kind="Close" Width="25" Height="25"/>
            </Button>

            <!--Page Title-->
            <TextBlock x:Name="titleText" Text="Settings" Style="{StaticResource pageTitle}"/>

            <!--Page Content-->
            <ContentPresenter x:Name="container" Grid.Row="2">
                <ContentPresenter.Content>
                    <pages:Options/>
                </ContentPresenter.Content>
            </ContentPresenter>

        </Grid>

    </Border>
    
</Window>
