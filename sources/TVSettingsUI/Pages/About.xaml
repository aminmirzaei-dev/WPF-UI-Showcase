<UserControl x:Class="TVSettingsUI.Pages.About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TVSettingsUI.Pages" 
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks">
    
    <Border CornerRadius="5" Padding="20 40" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="800" Margin="50 0" Background="#374270">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 15 0">
                <TextBlock Style="{StaticResource aboutText}">
                    
                    
                    
                     <icon:PackIconMaterial
        Kind="Factory"
        Width="22"
        Height="22"
        Margin="0,0,8,0"
        VerticalAlignment="Center"/>
                    
                                        <Run Text="Manufacturer : "/>

                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                    
                     <icon:PackIconMaterial
        Kind="Calendar"
        Width="22"
        Height="22"
        Margin="0,0,8,0"
        VerticalAlignment="Center"/>
                    
                                        <Run Text="Produce Year : "/>
                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                                 <icon:PackIconMaterial
Kind="Tag"
Width="22"
Height="22"
Margin="0,0,8,0"
VerticalAlignment="Center"/>
            
                                <Run Text="Version : "/>
                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                                 <icon:PackIconMaterial
Kind="Earth"
Width="22"
Height="22"
Margin="0,0,8,0"
VerticalAlignment="Center"/>
            
                                <Run Text="Country : "/>
                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                     <icon:PackIconMaterial
        Kind="City"
        Width="22"
        Height="22"
        Margin="0,0,8,0"
        VerticalAlignment="Center"/>
                    
                                        <Run Text="City : "/>
                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                     <icon:PackIconMaterial
        Kind="Home"
        Width="22"
        Height="22"
        Margin="0,0,8,0"
        VerticalAlignment="Center"/>
                    
                                        <Run Text="Address : "/>
                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                     <icon:PackIconMaterial
        Kind="CodeBraces"
        Width="22"
        Height="22"
        Margin="0,0,8,0"
        VerticalAlignment="Center"/>
                    
                                        <Run Text="Developer Name : "/>
                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                     <icon:PackIconMaterial
        Kind="Email"
        Width="22"
        Height="22"
        Margin="0,0,8,0"
        VerticalAlignment="Center"/>
                    
                                        <Run Text="Developer Gmail : "/>
                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                     <icon:PackIconMaterial
        Kind="Github"
        Width="22"
        Height="22"
        Margin="0,0,8,0"
        VerticalAlignment="Center"/>
                    
                                        <Run Text="Developer Github : "/>
                </TextBlock>
                <TextBlock Style="{StaticResource aboutText}">
                     <icon:PackIconMaterial
        Kind="Instagram"
        Width="22"
        Height="22"
        Margin="0,0,8,0"
        VerticalAlignment="Center"/>
                    
                                        <Run Text="Developer Instagram : "/>
                </TextBlock>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Grid.Column="1" Margin="15 0 0 0">
                <TextBlock Text="Sony" Style="{StaticResource aboutText}"/>
                <TextBlock Text="2026" Style="{StaticResource aboutText}"/>
                <TextBlock Text="1.3.5" Style="{StaticResource aboutText}"/>
                <TextBlock Text="Iran" Style="{StaticResource aboutText}"/>
                <TextBlock Text="Tehran" Style="{StaticResource aboutText}"/>
                <TextBlock Text="Elahiyeh, Fereshteh Street" Style="{StaticResource aboutText}"/>
                <TextBlock Text="Amin Mirzaei" Style="{StaticResource aboutText}"/>
                <TextBlock Text="aminmirzaei@gmail.com" Style="{StaticResource aboutText}"/>
                <TextBlock Text="aminmirzaei-dev" Style="{StaticResource aboutText}"/>
                <TextBlock Text="aminmirzaei.dev" Style="{StaticResource aboutText}"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
