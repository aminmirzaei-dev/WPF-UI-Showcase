<UserControl x:Class="TVSettingsUI.Pages.Network"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TVSettingsUI.Pages"
             xmlns:controls="clr-namespace:TVSettingsUI.Controls">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="800" Margin="50 0">

        <controls:TVToggleButton Title="Enable Wifi" HasToggle="True" IsChecked="True"/>
        <controls:TVToggleButton Title="         Network SDN-1" HasText="True" HasToggle="False" Text="...  "/>
        <controls:TVToggleButton Title="         Network SDN-2" HasText="True" HasToggle="False" Text="...  "/>
        <controls:TVToggleButton Title="         Network SDN-3" HasText="True" HasToggle="False" Text="...  "/>
        <controls:TVToggleButton Title="Enable Hotspot" HasToggle="True"/>
        <controls:TVToggleButton Title="Mac Address"/>
    </StackPanel>
</UserControl>
