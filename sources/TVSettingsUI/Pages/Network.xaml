<UserControl x:Class="TVSettingsUI.Pages.Network"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TVSettingsUI.Pages"
             xmlns:controls="clr-namespace:TVSettingsUI.Controls">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="800" Margin="50 0">

        <controls:TVToggleButton Icon="Wifi"
                                 Title="{Binding [EnableWiFi],
           Source={StaticResource LanguageService},
           Mode=OneWay}" HasToggle="True" IsChecked="True"/>
        <controls:TVToggleButton Title="         Network SDN-1" HasText="True" HasToggle="False" Text="...  "/>
        <controls:TVToggleButton Title="         Network SDN-2" HasText="True" HasToggle="False" Text="...  "/>
        <controls:TVToggleButton Title="         Network SDN-3" HasText="True" HasToggle="False" Text="...  "/>
        <controls:TVToggleButton Icon="WifiPlus"
                                 Title="{Binding [EnableHotspot],
           Source={StaticResource LanguageService},
           Mode=OneWay}" HasToggle="True"/>
        <controls:TVToggleButton Icon="Lan"
                                 Title="{Binding [MacAddress],
           Source={StaticResource LanguageService},
           Mode=OneWay}"/>
    </StackPanel>
</UserControl>
