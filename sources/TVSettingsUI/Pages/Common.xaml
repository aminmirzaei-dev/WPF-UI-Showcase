<UserControl x:Class="TVSettingsUI.Pages.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TVSettingsUI.Pages"
             xmlns:controls="clr-namespace:TVSettingsUI.Controls"
             Name="commonPage"
             >
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                MaxWidth="800"
                Margin="50 0">

        <controls:TVOptionsElement Title="Themes"
                                Icon="Palette">

            <controls:TVOptionsElement.Options>


                <controls:TVRadioButton Width="60"
                                     Height="60"
                                     Margin="5,0"
                                     CircleBackground="DodgerBlue"
                                     GroupName="Themes" />

                <controls:TVRadioButton Width="60"
                                     Height="60"
                                     Margin="5,0"
                                     CircleBackground="Green"
                                     GroupName="Themes" />

                <controls:TVRadioButton Width="60"
                                     Height="60"
                                     Margin="5,0"
                                     CircleBackground="#E91E63"
                                     GroupName="Themes" />

                <controls:TVRadioButton Width="60"
                                        Height="60"
                                        Margin="5,0"
                                        CircleBackground="SlateBlue"
                                        GroupName="Themes" />

                <controls:TVRadioButton Width="60"
                                        Height="60"
                                        Margin="5,0"
                                        CircleBackground="Orange"
                                        GroupName="Themes" />

                <controls:TVRadioButton Width="60"
                                        Height="60"
                                        Margin="5,0"
                                        CircleBackground="DeepPink"
                                        GroupName="Themes" />

            </controls:TVOptionsElement.Options>

        </controls:TVOptionsElement>

        <controls:TVOptionsElement Title="Languages"
                                   Icon="Earth">

            <controls:TVOptionsElement.Options>

                <controls:TVRadioButton Width="60"
                                        Height="60"
                                        Margin="5,0"
                                        ImageSource="/Images/Countries/USA.png"
                                        GroupName="Languages" />


                <controls:TVRadioButton Width="55"
                                        Height="55"
                                        Margin="5,0"
                                        ImageSource="/Images/Countries/Germany.png"
                                        GroupName="Languages" />

                <controls:TVRadioButton Width="60"
                                        Height="60"
                                        Margin="5,0"
                                        ImageSource="/Images/Countries/Spain.png"
                                        GroupName="Languages" />

                <controls:TVRadioButton Width="60"
                                        Height="60"
                                        Margin="5,0"
                                        ImageSource="/Images/Countries/China.png"
                                        GroupName="Languages" />

                <controls:TVRadioButton Width="60"
                                        Height="60"
                                        Margin="5,0"
                                        ImageSource="/Images/Countries/Iran.png"
                                        GroupName="Languages" />


            </controls:TVOptionsElement.Options>

        </controls:TVOptionsElement>



    </StackPanel>
</UserControl>
