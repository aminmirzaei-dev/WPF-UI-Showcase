<UserControl x:Class="TVSettingsUI.Pages.Storage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TVSettingsUI.Pages"
             xmlns:controls="clr-namespace:TVSettingsUI.Controls"
             xmlns:livechart="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Border CornerRadius="5"
            Padding="20 30"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            FlowDirection="{Binding FlowDirection,
                Source={StaticResource LanguageService}}"
            MaxWidth="800"
            Margin="50 0"
            MinHeight="400"
            Background="#374270">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="24"
                           Foreground="#ffffff"
                           Margin="20 20 0 40">
                                 <icon:PackIconMaterial Kind="Harddisk"
                                                        Width="22"
                                                        Height="22"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center" />
                    
                    <Run Text="{Binding [TotalSize],
           Source={StaticResource LanguageService},
           Mode=OneWay}" />
                    <Run Text=" : 9.6 GB" />
                </TextBlock>

                <!--Chart-->
                <livechart:PieChart Margin="0,0,100,0"
                                    LegendLocation="None"
                                    InnerRadius="110"
                                    Height="200">
                    <livechart:PieChart.Series>
                        <livechart:PieSeries Values="845"
                                             StrokeThickness="0"
                                             Fill="#86C56A" />
                        <livechart:PieSeries Values="205"
                                             StrokeThickness="0"
                                             Fill="#21C1D9" />
                        <livechart:PieSeries Values="309"
                                             StrokeThickness="0"
                                             Fill="#5788EE" />
                        <livechart:PieSeries Values="983"
                                             StrokeThickness="0"
                                             Fill="#F7E68A" />
                        <livechart:PieSeries Values="80"
                                             StrokeThickness="0"
                                             Fill="#FCAA2C" />
                        <livechart:PieSeries Values="300"
                                             StrokeThickness="0"
                                             Fill="#F95F15" />
                        <livechart:PieSeries Values="1200"
                                             StrokeThickness="0"
                                             Fill="#DBDEED" />
                    </livechart:PieChart.Series>
                </livechart:PieChart>

            </StackPanel>

            <TextBlock FontSize="20"
                       Margin="0,40,100,0"
                       Foreground="#ffffff"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                
                <Run Text="{Binding [Used],
           Source={StaticResource LanguageService},
           Mode=OneWay}" />
                <Run Text=" : 3.7 GB" />

            </TextBlock>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <controls:TVStorageDesc Title="{Binding [System], 
                               Source={StaticResource LanguageService}, 
                               Mode=OneWay, 
                               StringFormat={}{0} : 810 MB}"
                                        Icon="Chip"
                                        Color="#86C56A" />
                
                
                <controls:TVStorageDesc Title="{Binding [Photos], 
                               Source={StaticResource LanguageService}, 
                               Mode=OneWay, 
                               StringFormat={}{0} : 205 MB}"
                                        Icon="Image"
                                        Color="#21C1D9" />
                <controls:TVStorageDesc Title="{Binding [Musics], 
                               Source={StaticResource LanguageService}, 
                               Mode=OneWay, 
                               StringFormat={}{0} : 309 MB}"
                                        Icon="Music"
                                        Color="#5788EE" />
                <controls:TVStorageDesc Title="{Binding [Applications], 
                               Source={StaticResource LanguageService}, 
                               Mode=OneWay, 
                               StringFormat={}{0} : 983 MB}"
                                        Icon="Application"
                                        Color="#F7E68A" />
                <controls:TVStorageDesc Title="{Binding [Videos], 
                               Source={StaticResource LanguageService}, 
                               Mode=OneWay, 
                               StringFormat={}{0} : 80 MB}"
                                        Icon="Video"
                                        Color="#FCAA2C" />
                <controls:TVStorageDesc Title="{Binding [Other], 
                               Source={StaticResource LanguageService}, 
                               Mode=OneWay, 
                               StringFormat={}{0} : 300 MB}"
                                        Icon="Folder"
                                        Color="#F95F15" />
                <controls:TVStorageDesc Title="{Binding [AvailableSize], 
                               Source={StaticResource LanguageService}, 
                               Mode=OneWay, 
                               StringFormat={}{0} : 250 MB}"
                                        Icon="ChartDonut"
                                        Color="#DBDEED" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
