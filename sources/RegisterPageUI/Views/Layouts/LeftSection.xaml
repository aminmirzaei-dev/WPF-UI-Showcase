<UserControl x:Class="RegisterPageUI.Views.Layouts.LeftSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RegisterPageUI.Views.Layouts"
             xmlns:icons="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d">
    
    <Border Background="Chocolate"
            Padding="30"
            CornerRadius="25 0 0 25">
        <StackPanel VerticalAlignment="Center">
            <Ellipse Margin="0 0 0 40"
                     Width="160"
                     Height="160">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="/Resources/Images/UserIcon.png" />
                </Ellipse.Fill>
            </Ellipse>

            <TextBlock TextAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="28"
                       Text="Let's get you set up"
                       Foreground="White" />
            <TextBlock TextWrapping="Wrap"
                       FontSize="16"
                       TextAlignment="Center"
                       Margin="0 20 0 20"
                       Foreground="WhiteSmoke"
                       Text="it should only take a couple of minutes to pair with your watch" />

            <Button Style="{StaticResource NextButton}">
                <icons:ImageAwesome Icon="AngleRight"
                                 Width="25"
                                 Height="25"
                                 Foreground="Brown"
                                 Margin="3 0 0 0" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
