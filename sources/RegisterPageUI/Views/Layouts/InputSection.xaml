<UserControl x:Class="RegisterPageUI.Views.Layouts.InputSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RegisterPageUI.Views.Layouts"
             xmlns:icons="http://schemas.fontawesome.io/icons/"
             xmlns:controls="clr-namespace:RegisterPageUI.Controls"
             mc:Ignorable="d" 
            >
    <Border
            Padding="20"
            Background="#ffffff"
            CornerRadius="0 25 25 0">
        <Grid>

            <Button Width="30"
                    Margin="0,4,5,0"
                    Content="Close"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"
                    Style="{StaticResource TitleButtonStyle}">
            </Button>

            

            <Button Width="30"
                    Margin="0 4 40 0"
                    Content="WindowMinimize"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Click="MinimizeButton_Click"
                    Style="{StaticResource TitleButtonStyle}">
            </Button>


            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,44,0,0"
                  Width="424">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Name"
                           Style="{StaticResource MainTextStyle}" />
                <TextBlock Grid.Row="1"
                           Text="Family"
                           Style="{StaticResource MainTextStyle}" />
                <TextBlock Grid.Row="2"
                           Text="Gender"
                           Style="{StaticResource MainTextStyle}" />
                <TextBlock Grid.Row="3"
                           Text="Date of Birth"
                           Style="{StaticResource MainTextStyle}" />
                <TextBlock Grid.Row="4"
                           Text="Email"
                           Style="{StaticResource MainTextStyle}" />
                <TextBlock Grid.Row="5"
                           Text="Mobile"
                           Style="{StaticResource MainTextStyle}" />
                <TextBlock Grid.Row="6"
                           Text="Membership"
                           Style="{StaticResource MainTextStyle}" />

                <controls:LiteTextBox Grid.Column="1"
                              Grid.Row="0"
                              Hint="Amin" />
                <controls:LiteTextBox Grid.Column="1"
                              Grid.Row="1"
                              Hint="Mirzaei" />
                <controls:LiteTextBox Grid.Column="1"
                              Grid.Row="3"
                              Hint="11/1/2007" />
                <controls:LiteTextBox Grid.Column="1"
                              Grid.Row="4"
                              Hint="aminmirzaeidev@email.com" />
                <controls:LiteTextBox Grid.Column="1"
                              Grid.Row="5"
                              Hint="+91 9765 43210" />

                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Grid.Row="2"
                            Margin="0 10">
                    <controls:CircleOption Text="Male"
                                 Icon="Male" />
                    <controls:CircleOption Text="Female"
                                 Icon="Female" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Grid.Row="6"
                            Margin="0 10">
                    <controls:CircleOption Text="Classic"
                                 Icon="CreditCard" />
                    <controls:CircleOption Text="Silver"
                                 Icon="CreditCard" />
                    <controls:CircleOption Text="Gold"
                                 Icon="CreditCard" />
                </StackPanel>

                <Grid Grid.Column="1"
                      Grid.Row="7"
                      Margin="0 40 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource MainButton}"
                            Margin="0 0 10 0"
                            Content="Cancel" />

                    <Button Grid.Column="1"
                            Style="{StaticResource MainDefaultButton}"
                            Margin="10 0 0 0"
                            Content="Save" />
                </Grid>

            </Grid>
        </Grid>
    </Border>
</UserControl>
