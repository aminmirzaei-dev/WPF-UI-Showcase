                <ListBoxItem>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#6979D8">

                            <Image Source="/Resources/Images/People/morgan.png"></Image>


                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,4,0">

                            <TextBlock Text="Morgan Freeman"
