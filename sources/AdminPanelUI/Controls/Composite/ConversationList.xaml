                                   FontSize="10" />

                    </Grid>

                </ListBoxItem>


                <ListBoxItem>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#8585E8">

                            <Image Source="/Resources/Images/People/paul.png"></Image>


                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,4,0">

                            <TextBlock Text="Pavel Durov"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Perfect, I'll buy it."
                                       Foreground="#8F9CC2"
                                       FontSize="12"
                                       Margin="0,3,0,0" />

                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="09:30 AM"
                                   Foreground="#8794B9"
                                   FontSize="10" />

                    </Grid>

                </ListBoxItem>


                <ListBoxItem>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#6979D8">

                            <Image Source="/Resources/Images/People/jadi.png"></Image>


                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,4,0">

