                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#43B8D5">

                            <Image Source="/Resources/Images/People/maryam.png"></Image>


                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,4,0">

                            <TextBlock Text="Maryam Mirzakhani"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Can you please provide..."
                                       Foreground="#8F9CC2"
                                       FontSize="12"
                                       Margin="0,3,0,0" />

                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="12:00 PM"
                                   Foreground="#8794B9"
                                   FontSize="10" />

                    </Grid>

                </ListBoxItem>


                <ListBoxItem>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
