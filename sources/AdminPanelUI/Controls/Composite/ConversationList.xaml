                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,4,0">

                            <TextBlock Text="Sydney Sweeney"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Thanks! I'll check it."
