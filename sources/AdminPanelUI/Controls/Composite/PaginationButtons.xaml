<UserControl x:Class="AdminPanelUI.Controls.PaginationButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:AdminPanelUI.Controls"
             xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">


    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">


        <!-- ============================================= -->
        <!-- Previous -->
        <!-- ============================================= -->

        <controls:APButton Width="40"
                           Height="40"
                           Icon="ChevronLeft"
                           Background="#303d73"
                           Margin="0,0,10,0" />


        <!-- ============================================= -->
        <!-- 1 -->
        <!-- ============================================= -->

        <controls:APButton Width="40"
                           Height="40"
                           Content="1"
                           Margin="0,0,10,0" />

        <!-- ============================================= -->
        <!-- 2 -->
        <!-- ============================================= -->

        <controls:APButton Width="40"
                           Height="40"
                           Content="2"
                           Background="#303d73"
                           Margin="0,0,10,0" />


        <!-- ============================================= -->
        <!-- 3 -->
        <!-- ============================================= -->

        <controls:APButton Width="40"
                           Height="40"
                           Content="3"
                           Background="#303d73"
                           Margin="0,0,10,0" />


        <!-- ============================================= -->
        <!-- ... -->
        <!-- ============================================= -->

        <controls:APButton Width="40"
                           Height="40"
                           Content="..."
                           Background="#303d73"
                           Margin="0,0,10,0" />


        <!-- ============================================= -->
        <!-- 10 -->
        <!-- ============================================= -->

        <controls:APButton Width="40"
                           Height="40"
                           Content="10"
                           Background="#303d73"
                           Margin="0,0,10,0" />


        <!-- ============================================= -->
        <!-- Next -->
        <!-- ============================================= -->

        <controls:APButton Width="40"
                           Height="40"
                           Icon="ChevronRight"
                           Background="#303d73"
                           Margin="0,0,10,0" />


    </StackPanel>
</UserControl>
