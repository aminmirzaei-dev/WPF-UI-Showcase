<UserControl x:Class="AdminPanelUI.Controls.APDevProfile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:AdminPanelUI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="150"
             d:DesignWidth="500">

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0 35 0 0">

        <!-- Profile Image -->
        <Grid Width="54"
              Height="54">

            <!-- Circle Clip -->
            <Grid.Clip>
                <EllipseGeometry Center="27,27"
                                 RadiusX="27"
                                 RadiusY="27" />
            </Grid.Clip>

            <Image x:Name="ProfileImage"
                   Width="54"
                   Height="54"
                   Stretch="UniformToFill"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   RenderOptions.BitmapScalingMode="Fant">

                <Image.Style>
                    <Style TargetType="Image">

                        <!-- Image -->
                        <Setter Property="Source"
                                Value="/Resources/Images/Developer/AminDevProfile.jpg" />

                    </Style>
                </Image.Style>

            </Image>

        </Grid>


        <!-- Text -->

        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Amin Mirzaei"
                       FontSize="15"
                       Margin="0 0 0 5"
                       Foreground="#C2CFFF" />
            <TextBlock Text=".Net and Desktop Developer"
                       Foreground="#7788bf"
                       FontSize="11" />
        </StackPanel>
       

    </StackPanel>
</UserControl>
