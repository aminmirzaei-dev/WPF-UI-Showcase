<UserControl x:Class="AdminPanelUI.Controls.ContactInfoRow"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">

    <Border Background="#1C2A5C"
            CornerRadius="5"
            Padding="10,7"
            Margin="0,2">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
            </Grid.ColumnDefinitions>

            <!-- Main Icon -->
            <Image Grid.Column="0"
                   Source="{Binding Icon, ElementName=root}"
                   Width="34"
                   Height="34"
                   Stretch="UniformToFill"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left" />

            <!-- Title -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Title, ElementName=root}"
                       FontSize="11"
                       Margin="10,0,0,0"
                       Foreground="WhiteSmoke"
                       VerticalAlignment="Center" />

            <!-- Value -->
            <TextBlock Grid.Column="2"
                       Text="{Binding Value, ElementName=root}"
                       FontSize="12"
                       Margin="30,0,0,0"
                       Foreground="White"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <!-- Action Icon -->
            <icons:IconBlock Grid.Column="3"
                          Icon="{Binding ActionIcon, ElementName=root}"
                          FontSize="11"
                          Foreground="#6876B0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right" />

        </Grid>

    </Border>

</UserControl>