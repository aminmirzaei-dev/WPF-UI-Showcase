<UserControl x:Class="AdminPanelUI.Controls.Composite.ContactInfoRow"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">

    <Border Background="#1C2A5C"
            CornerRadius="5"
            Padding="10,7"
            Margin="0,2">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="55" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
            </Grid.ColumnDefinitions>

            <!-- Main Icon -->
            <icons:IconBlock Grid.Column="0"
                          Icon="{Binding Icon, ElementName=root}"
                          FontSize="14"
                          Foreground="#8C82FF"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

            <!-- Title -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Title, ElementName=root}"
                       FontSize="9"
                       Foreground="#8D99C5"
                       VerticalAlignment="Center" />

            <!-- Value -->
            <TextBlock Grid.Column="2"
                       Text="{Binding Value, ElementName=root}"
                       FontSize="9"
                       Foreground="#D5D9EF"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <!-- Action Icon -->
            <icons:IconBlock Grid.Column="3"
                          Icon="{Binding ActionIcon, ElementName=root}"
                          FontSize="11"
                          Foreground="#6876B0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right" />

        </Grid>

    </Border>

</UserControl>