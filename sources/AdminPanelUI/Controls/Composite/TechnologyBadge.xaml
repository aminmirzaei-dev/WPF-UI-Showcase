<UserControl x:Class="AdminPanelUI.Controls.TechnologyBadge"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">

    <Border Background="#202F65"
            CornerRadius="7"
            Padding="10"
            MinWidth="70"
            MinHeight="70">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Icon -->
            <Image Grid.Column="0"
                   Source="{Binding Icon, ElementName=root}"
                   Width="34"
                   Height="34"
                   Stretch="UniformToFill"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

            <!-- Technology Name -->
            <TextBlock Text="{Binding TechnologyName, ElementName=root}"
                       FontSize="12"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,6,0,0" />

        </StackPanel>

    </Border>

</UserControl>