<UserControl x:Class="AdminPanelUI.Controls.Composite.TechnologyBadge"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">

    <Border Background="#202F65"
            CornerRadius="7"
            Padding="10"
            MinWidth="70"
            MinHeight="70">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Icon -->
            <icons:IconBlock Icon="{Binding Icon, ElementName=root}"
                          FontSize="24"
                          Foreground="{Binding IconColor, ElementName=root}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

            <!-- Technology Name -->
            <TextBlock Text="{Binding TechnologyName, ElementName=root}"
                       FontSize="9"
                       Foreground="#D8DCF2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,6,0,0" />

        </StackPanel>

    </Border>

</UserControl>