<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AdminPanelUI.Controls"
                    xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">

    <Style TargetType="{x:Type controls:APTextBox}">

        <!-- Default Values -->

        <Setter Property="Height"
                Value="40" />

        <Setter Property="Background"
                Value="#26396C" />

        <Setter Property="Foreground"
                Value="#E5E9F7" />

        <Setter Property="BorderBrush"
                Value="Transparent" />

        <Setter Property="BorderThickness"
                Value="0" />

        <Setter Property="FontSize"
                Value="13" />

        <Setter Property="Padding"
                Value="0" />

        <Setter Property="SelectionBrush"
                Value="#5362C4" />

        <Setter Property="SelectionTextBrush"
                Value="#FFFFFF" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:APTextBox}">

                    

                    <Grid>

                        <!-- Background -->

                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform"
                                                ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                        </Border>


                        <!-- Focus Ring -->

                        <Border x:Name="FocusBorder"
                                Background="Transparent"
                                BorderBrush="#6575D8"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.25" />
                            </Border.Effect>

                        </Border>


                        <!-- Content -->

                        <Grid>

                            <!-- Icon -->

                            <icons:IconBlock x:Name="PART_Icon"
                                             Icon="{TemplateBinding Icon}"
                                             FontSize="14"
                                             Foreground="{TemplateBinding IconBrush}"
                                             Margin="13,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center">


                                <icons:IconBlock.RenderTransform>
                                    <ScaleTransform x:Name="IconScale"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                </icons:IconBlock.RenderTransform>

                                <icons:IconBlock.RenderTransformOrigin>
                                    0.5,0.5
                                </icons:IconBlock.RenderTransformOrigin>

                            </icons:IconBlock>


                            <!-- Placeholder -->

                            <TextBlock x:Name="PART_Placeholder"
                                       Text="{TemplateBinding Placeholder}"
                                       Foreground="{TemplateBinding PlaceholderBrush}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       VerticalAlignment="Center"
                                       Margin="38,0,12,0"
                                       IsHitTestVisible="False"
                                       Opacity="0">

                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="PlaceholderTransform"
                                                        X="-3" />
                                </TextBlock.RenderTransform>

                            </TextBlock>


                            <!-- Text -->

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="38,0,12,0"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>

                    </Grid>


                    <!-- Triggeers -->

                    <ControlTemplate.Triggers>


                        <!-- Empty Text -->

                        <Trigger Property="Text"
                                 Value="">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <!-- Placeholder Fade In -->
                                        <DoubleAnimation Storyboard.TargetName="PART_Placeholder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.18" />

                                        <!-- Placeholder Slide In -->
                                        <DoubleAnimation Storyboard.TargetName="PlaceholderTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.18" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>


                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <!-- Placeholder Fade Out -->
                                        <DoubleAnimation Storyboard.TargetName="PART_Placeholder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />

                                        <!-- Placeholder Slide Out -->
                                        <DoubleAnimation Storyboard.TargetName="PlaceholderTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="-3"
                                                         Duration="0:0:0.12" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Focus -->

                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <!-- Focus Ring -->
                                        <DoubleAnimation Storyboard.TargetName="FocusBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2" />

                                        <!-- Slight Scale -->
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.005"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.005"
                                                         Duration="0:0:0.18" />

                                        <!-- Icon Scale -->
                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.08"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.08"
                                                         Duration="0:0:0.18" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>


                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <!-- Focus Ring -->
                                        <DoubleAnimation Storyboard.TargetName="FocusBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.15" />

                                        <!-- Scale -->
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                        <!-- Icon -->
                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                        <DoubleAnimation Storyboard.TargetName="IconScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.15" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Disabledd -->

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="MainBorder"
                                    Property="Opacity"
                                    Value="0.45" />

                            <Setter TargetName="PART_Icon"
                                    Property="Opacity"
                                    Value="0.45" />

                        </Trigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>