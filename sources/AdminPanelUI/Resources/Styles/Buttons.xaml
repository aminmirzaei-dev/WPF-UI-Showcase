<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AdminPanelUI.Controls"
                    xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">


    <Style TargetType="{x:Type controls:APRadioButton}">

        <!-- Default Properties -->
        <Setter Property="Background"
                Value="#18244A" />
        <Setter Property="BorderBrush"
                Value="#293B78" />
        <Setter Property="BorderThickness"
                Value="1.5" />

        <Setter Property="Foreground"
                Value="#E8EAF2" />

        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="SemiBold" />

        <Setter Property="Height"
                Value="98" />
        <Setter Property="MinWidth"
                Value="300" />

        <Setter Property="Padding"
                Value="24,0" />
        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:APRadioButton}">

                    <Grid>

                        <!-- Main Transform -->
                        <Grid x:Name="ScaleContainer"
                              RenderTransformOrigin="0.5,0.5">

                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Grid.RenderTransform>

                            <!-- Shadow / Glow -->
                            <Border x:Name="Glow"
                                    CornerRadius="14"
                                    Opacity="0"
                                    Margin="2">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22"
                                                      ShadowDepth="0"
                                                      Opacity="0.8"
                                                      Color="#7167D8" />
                                </Border.Effect>

                            </Border>


                            <!-- Main Border -->
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    SnapsToDevicePixels="True">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>


                                    <!-- Icon -->
                                    <icons:IconBlock x:Name="Icon"
                                                     Grid.Column="0"
                                                     FontSize="14"
                                                     Margin="20,0,18,0"
                                                     VerticalAlignment="Center"
                                                     Icon="{TemplateBinding Icon}"
                                                     Foreground="White" />


                                    <!-- Text -->
                                    <ContentPresenter Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>


                    <ControlTemplate.Triggers>

                        <!-- Mouse Hover -->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <!-- Background -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#202E5D"
                                                        Duration="0:0:0.18" />

                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#4B5E9E"
                                                        Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.35"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleContainer"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.015"
                                                         Duration="0:0:0.12" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleContainer"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.015"
                                                         Duration="0:0:0.12" />

                                    </Storyboard>

                                </BeginStoryboard>
                            </Trigger.EnterActions>


                            <Trigger.ExitActions>
                                <BeginStoryboard>

                                    <Storyboard>

                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#18244A"
                                                        Duration="0:0:0.18" />

                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#293B78"
                                                        Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.18" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleContainer"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleContainer"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12" />

                                    </Storyboard>

                                </BeginStoryboard>
                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Pressed / Click -->

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Trigger.EnterActions>
                                <BeginStoryboard>

                                    <Storyboard>

                                        <!-- Scale Down -->
                                        <DoubleAnimation Storyboard.TargetName="ScaleContainer"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.965"
                                                         Duration="0:0:0.07" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleContainer"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.965"
                                                         Duration="0:0:0.07" />

                                        <!-- Glow -->
                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.65"
                                                         Duration="0:0:0.07" />

                                    </Storyboard>

                                </BeginStoryboard>
                            </Trigger.EnterActions>


                            <Trigger.ExitActions>
                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleContainer"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.015"
                                                         Duration="0:0:0.10" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleContainer"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.015"
                                                         Duration="0:0:0.10" />

                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.35"
                                                         Duration="0:0:0.10" />

                                    </Storyboard>

                                </BeginStoryboard>
                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Selected -->

                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="#1D2B5A" />

                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="#7167D8" />

                            <Setter TargetName="Root"
                                    Property="BorderThickness"
                                    Value="2" />

                            <Setter TargetName="Icon"
                                    Property="Foreground"
                                    Value="#8A78FF" />

                            <Setter Property="Foreground"
                                    Value="#8A78FF" />

                            <Setter TargetName="Glow"
                                    Property="Opacity"
                                    Value="0.45" />

                        </Trigger>


                        <!-- Disabled -->

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ScaleContainer"
                                    Property="Opacity"
                                    Value="0.45" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="CloseButtonStyle"
           TargetType="{x:Type Button}">

        <Setter Property="Background"
                Value="#EF4444" />

        <Setter Property="Content"
                Value="×" />

        <Setter Property="FontSize"
                Value="20" />


        <Setter Property="Foreground"
                Value="White" />

        <Setter Property="BorderThickness"
                Value="0" />


        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border x:Name="CloseBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="16">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />

                    </Border>


                    <ControlTemplate.Triggers>

                        <!-- Hover -->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="CloseBorder"
                                    Property="Background"
                                    Value="#DC2626" />

                        </Trigger>


                        <!-- Press -->

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="CloseBorder"
                                    Property="Background"
                                    Value="#B91C1C" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <Style TargetType="{x:Type controls:APButton}">

        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="Background"
                Value="#6655D8" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="18,10" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:APButton}">

                    <ControlTemplate.Resources>

                        <SolidColorBrush x:Key="HoverBrush"
                                         Color="#7565E5" />

                        <SolidColorBrush x:Key="PressedBrush"
                                         Color="#5748C2" />

                        <Storyboard x:Key="MouseOverAnimation">

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.015"
                                             Duration="0:0:0.12" />

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.015"
                                             Duration="0:0:0.12" />

                        </Storyboard>

                        <Storyboard x:Key="MouseLeaveAnimation">

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1"
                                             Duration="0:0:0.12" />

                            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1"
                                             Duration="0:0:0.12" />

                        </Storyboard>

                    </ControlTemplate.Resources>


                    <Grid>

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform"
                                                ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                            <Border.RenderTransformOrigin>
                                0.5,0.5
                            </Border.RenderTransformOrigin>

                            <Border.Effect>

                                <DropShadowEffect x:Name="ShadowEffect"
                                                  BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.20" />

                            </Border.Effect>


                            <Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <!--Icon-->

                                    <icons:IconBlock x:Name="IconElement"
                                                     Icon="{TemplateBinding Icon}"
                                                     FontSize="{TemplateBinding IconSize}"
                                                     Foreground="{TemplateBinding Foreground}"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="{TemplateBinding IconAlignment}"
                                                     Margin="{TemplateBinding IconMargin}" />

                                    <!-- Text -->

                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>


                    <ControlTemplate.Triggers>

                        <!-- Hover -->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{Binding HoverBackground,
                            RelativeSource={RelativeSource TemplatedParent}}" />

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.015"
                                                         Duration="0:0:0.12" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.015"
                                                         Duration="0:0:0.12" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Pressed -->

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.88" />

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97"
                                                         Duration="0:0:0.06" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97"
                                                         Duration="0:0:0.06" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.08" />

                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.08" />

                                    </Storyboard>

                                </BeginStoryboard>

                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Disabled -->

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.45" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <Style TargetType="{x:Type controls:APMenuItem}">

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Background"
                Value="Transparent" />

        <Setter Property="Foreground"
                Value="#707DB2" />

        <Setter Property="Tag"
                Value="#6673B7" />

        <Setter Property="Margin"
                Value="0,0,0,5" />

        <Setter Property="Height"
                Value="45" />

        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />


        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:APMenuItem}">

                    <Grid>

                         <!--Hover Background-->

                        <Border x:Name="HoverBackground"
                                Background="#344277"
                                CornerRadius="7"
                                Opacity="0" />


                        <!-- Active Background-->

                        <Border x:Name="ActiveBackground"
                                CornerRadius="7"
                                Opacity="0">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5"
                                                     EndPoint="1,0.5">

                                    <GradientStop Color="#31407B"
                                                  Offset="0" />

                                    <GradientStop Color="#495385"
                                                  Offset="1" />

                                </LinearGradientBrush>
                            </Border.Background>

                        </Border>


                        <!--Active SideBar-->

                        <Border x:Name="ActiveBar"
                                Width="4"
                                Height="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="#A5A1F5"
                                CornerRadius="0,4,4,0"
                                Opacity="0">

                            <Border.Effect>
                                <DropShadowEffect Color="#9A94FF"
                                                  BlurRadius="14"
                                                  ShadowDepth="0"
                                                  Opacity="0.9" />
                            </Border.Effect>

                        </Border>


                        <!--Content-->

                        <Grid x:Name="ContentGrid"
                              RenderTransformOrigin="0.5,0.5">

                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Grid.RenderTransform>


                            <StackPanel Orientation="Horizontal">

                                <!--Icon-->

                                <Grid Width="25"
                                      Height="25"
                                      Margin="15,0,0,0">

                                    <icons:IconBlock x:Name="MenuIcon"
                                                     Icon="{TemplateBinding Icon}"
                                                     Foreground="{TemplateBinding Foreground}"
                                                     FontSize="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     RenderTransformOrigin="0.5,0.5">

                                        <icons:IconBlock.RenderTransform>
                                            <ScaleTransform ScaleX="1"
                                                            ScaleY="1" />
                                        </icons:IconBlock.RenderTransform>

                                    </icons:IconBlock>

                                </Grid>


                                <!-- Text -->

                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0" />

                            </StackPanel>

                        </Grid>

                    </Grid>


                    <!--Animations-->

                    <ControlTemplate.Resources>

                        <!-- Hover IN -->

                        <Storyboard x:Key="HoverIn">

                            <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.18" />

                            <DoubleAnimation Storyboard.TargetName="MenuIcon"
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.08"
                                             Duration="0:0:0.18" />

                            <DoubleAnimation Storyboard.TargetName="MenuIcon"
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.08"
                                             Duration="0:0:0.18" />

                        </Storyboard>


                        <!-- Hover OUT -->

                        <Storyboard x:Key="HoverOut">

                            <DoubleAnimation Storyboard.TargetName="HoverBackground"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.22" />

                            <DoubleAnimation Storyboard.TargetName="MenuIcon"
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1"
                                             Duration="0:0:0.22" />

                            <DoubleAnimation Storyboard.TargetName="MenuIcon"
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1"
                                             Duration="0:0:0.22" />

                        </Storyboard>


                        <!--Active IN-->

                        <Storyboard x:Key="ActiveIn">

                            <!-- Background -->

                            <DoubleAnimation Storyboard.TargetName="ActiveBackground"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.28" />


                            <!-- Side Bar -->

                            <DoubleAnimation Storyboard.TargetName="ActiveBar"
                                             Storyboard.TargetProperty="Height"
                                             From="0"
                                             To="35"
                                             Duration="0:0:0.30" />

                            <DoubleAnimation Storyboard.TargetName="ActiveBar"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.20" />


                            <!-- Icon -->

                            <DoubleAnimation Storyboard.TargetName="MenuIcon"
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.14"
                                             Duration="0:0:0.25" />

                            <DoubleAnimation Storyboard.TargetName="MenuIcon"
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.14"
                                             Duration="0:0:0.25" />

                        </Storyboard>


                        <!--Active OUT-->

                        <Storyboard x:Key="ActiveOut">

                            <DoubleAnimation Storyboard.TargetName="ActiveBackground"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.20" />

                            <DoubleAnimation Storyboard.TargetName="ActiveBar"
                                             Storyboard.TargetProperty="Height"
                                             To="0"
                                             Duration="0:0:0.20" />

                            <DoubleAnimation Storyboard.TargetName="ActiveBar"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.15" />

                            <DoubleAnimation Storyboard.TargetName="MenuIcon"
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1"
                                             Duration="0:0:0.20" />

                            <DoubleAnimation Storyboard.TargetName="MenuIcon"
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1"
                                             Duration="0:0:0.20" />

                        </Storyboard>


                        <!-- PRESS -->

                        <Storyboard x:Key="Press">

                            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.96"
                                             Duration="0:0:0.06" />

                            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.96"
                                             Duration="0:0:0.06" />

                        </Storyboard>


                        <!-- RELEASE -->

                        <Storyboard x:Key="Release">

                            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1"
                                             Duration="0:0:0.12" />

                            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1"
                                             Duration="0:0:0.12" />

                        </Storyboard>

                    </ControlTemplate.Resources>


                    <!--Triggers -->

                    <ControlTemplate.Triggers>


                        <!-- Hover -->

                        <EventTrigger RoutedEvent="Mouse.MouseEnter">

                            <BeginStoryboard Storyboard="{StaticResource HoverIn}" />

                        </EventTrigger>


                        <EventTrigger RoutedEvent="Mouse.MouseLeave">

                            <BeginStoryboard Storyboard="{StaticResource HoverOut}" />

                        </EventTrigger>


                        <!-- Selected -->

                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Setter Property="Foreground"
                                    Value="#D8DEFF" />

                            <Setter Property="Tag"
                                    Value="#7071F0" />

                            <Trigger.EnterActions>

                                <BeginStoryboard Storyboard="{StaticResource ActiveIn}" />

                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard Storyboard="{StaticResource ActiveOut}" />

                            </Trigger.ExitActions>

                        </Trigger>


                        <!-- Press -->

                        <EventTrigger RoutedEvent="Mouse.PreviewMouseDown">

                            <BeginStoryboard Storyboard="{StaticResource Press}" />

                        </EventTrigger>


                        <EventTrigger RoutedEvent="Mouse.PreviewMouseUp">

                            <BeginStoryboard Storyboard="{StaticResource Release}" />

                        </EventTrigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="topMenuButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="#9EABE2" />
        <Setter Property="Width"
                Value="80" />
        <Setter Property="Height"
                Value="30" />
        <Setter Property="Margin"
                Value="5 0 0 0" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#5B60C4" />
                <Setter Property="Foreground"
                        Value="#ffffff" />
            </Trigger>
        </Style.Triggers>
    </Style>



</ResourceDictionary>