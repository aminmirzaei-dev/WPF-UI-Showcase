<Application x:Class="AdminPanelUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdminPanelUI"
             xmlns:services="clr-namespace:AdminPanelUI.Services"
             StartupUri="Views/Windows/Main.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <services:LocalizationService x:Key="LocalizationService" />

            <services:ThemeService x:Key="ThemeService" />


            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBlocks.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBoxs.xaml" />
                <ResourceDictionary Source="Resources/Styles/IconImages.xaml" />
                <ResourceDictionary Source="Resources/Themes/Purple.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
