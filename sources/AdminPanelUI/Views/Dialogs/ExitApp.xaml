<Window x:Class="AdminPanelUI.Views.Dialogs.ExitApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AdminPanelUI.Controls"
        xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="ExitApp"
        Width="450"
        Height="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border x:Name="MainBorder"
            Background="#21104a"
            CornerRadius="18"
            Margin="10"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">


        <Border.RenderTransform>

            <TranslateTransform Y="15" />

        </Border.RenderTransform>


        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="50" />

                <RowDefinition Height="*" />

            </Grid.RowDefinitions>


            <!-- TOP BAR-->

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="Window_MouseLeftButtonDown">


                <!-- Close Button -->

                <Button Width="30"
                                   Height="30"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"
                                   Style="{StaticResource CloseButtonStyle}"
                                   Click="CloseButton_Click">

                </Button>

            </Grid>


            <!-- CONTENT  -->

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">


                <!-- Exit Icon -->

                <Border Width="65"
                        Height="65"
                        CornerRadius="32.5"
                        Background="#2D2142"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">

                    <icons:IconBlock Icon="RightFromBracket"
                                     FontSize="28"
                                     Foreground="#A78BFA"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

                </Border>


                <!--Title-->

                <TextBlock Text="Do you want to exit the app?"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#F5F3FF"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />


                <!-- Sub Title -->

                <TextBlock Text="Are you sure you want to exit the application?"
                           FontSize="13"
                           Foreground="#A8A0B8"
                           Margin="0,7,0,18"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />


                <!-- Buttons -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">


                    <!-- NO -->

                    <controls:APButton Content="No"
                                       Width="120"
                                       Height="40"
                                       Icon="Cancel"
                                       Margin="0,0,8,0"
                                       Background="#30283D"
                                       Foreground="#E9E3F2"
                                       Click="NoButton_Click" />


                    <!-- YES-->

                    <controls:APButton Content="Yes"
                                       Width="120"
                                       Height="40"
                                       Icon="PowerOff"
                                       Background="#EF4444"
                                       Foreground="White"
                                       Click="YesButton_Click" />

                </StackPanel>

            </StackPanel>

        </Grid>

    </Border>

</Window>