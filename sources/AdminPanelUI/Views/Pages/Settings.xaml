<UserControl x:Class="AdminPanelUI.Views.Pages.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdminPanelUI.Views.Pages"
             xmlns:controls="clr-namespace:AdminPanelUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Grid.Column="1"
            CornerRadius="0 10 10 0">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,0"
                                 EndPoint="0,1">
                <GradientStop Color="#41518F"
                              Offset="0" />
                <GradientStop Color="#2C386C"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <StackPanel Width="320">

                <controls:APRadioButton Content="Light"
                                     GroupName="Theme"
                                     Icon="Sun"
                                     
                                     Margin="0,0,0,12" />

                <controls:APRadioButton Content="Dark"
                                     GroupName="Theme"
                                     Icon="Moon"
                                      />

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
