<UserControl x:Class="AdminPanelUI.Views.Menus.Workspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdminPanelUI.Views.Menus"
             xmlns:controls="clr-namespace:AdminPanelUI.Controls"
             xmlns:icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d">
    
    <Border CornerRadius="10 0 0 10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0"
                                 EndPoint="0.5,1">
                <GradientStop Color="#223266"
                              Offset="0" />
                <GradientStop Color="#27376B"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel>
            <!--Username-->
            <controls:UserProfile />

            <Separator Height="0.8"
                       Background="#46558a"
                       Margin="20 30 20 30" />

            <!--Menu Buttons-->
            <controls:APMenuItem Icon="Home"
                                 
                                 Content="Dashboard"
                                 IsChecked="True" />

            <controls:APMenuItem
                                 Icon="FileSignature"
                                 Content="Listing"/>

            <controls:APMenuItem
                                 Icon="EnvelopeOpenText"
                                 Content="Messages" />

            <controls:APMenuItem
                                 Icon="ShoppingCart"
                                 Content="Orders"/>

            <controls:APMenuItem Icon="ChartArea"
                                 Content="Statistics" />

            <controls:APMenuItem Icon="Cog"
                                 Content="Settings" />

            <controls:APMenuItem Icon="User"
                                 Content="About Us" />

            <controls:APMenuItem Icon="PowerOff"
                                 Content="Logout"
                                 Click="btnExit_Click" />

        </StackPanel>
    </Border>
</UserControl>
